---
import Glass from "../components/Glass.astro";
import GlassRow from "../components/GlassRow.astro";
import Icon from "../components/Icon.astro";
import Longform from "../components/Longform.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { buildCitations } from "../utils/citation.ts";
import { corpusMeta } from "../utils/corpus-meta.ts";
import { getCorpora, getCorpus, getIssue, getPage, getSiteTotals } from "../utils/corpus.ts";
import { pageParam } from "../utils/reader.ts";
import type { ArticleBlock } from "../utils/types.ts";

const totals = getSiteTotals();
const corpora = getCorpora();

/** 首版版權登記結果，取自 Jyutman-Corpus rights/0.3-rights-summary.md（唔喺發佈層數據入面）。 */
const RIGHTS_VERIFIED = 5;
const RIGHTS_TOTAL = 9;

/** 引用示範：同首頁原文樣張同一篇（廣東白話報第一期第 006 葉）。 */
const SAMPLE = { corpus: "gd-vernacular-paper", issue: "issue-01", page: 6 };
const sampleCorpus = getCorpus(SAMPLE.corpus);
const sampleIssue = getIssue(SAMPLE.corpus, SAMPLE.issue);
const sampleArticle = getPage(SAMPLE.corpus, SAMPLE.issue, SAMPLE.page)?.blocks.find(
  (block): block is ArticleBlock => block.type === "article",
);
if (!sampleCorpus || !sampleIssue || !sampleArticle) {
  throw new Error(`數據開放頁引用示範搵唔到：${SAMPLE.corpus}/${SAMPLE.issue}/${pageParam(SAMPLE.page)}`);
}
const sampleHref = `/read/${SAMPLE.corpus}/${SAMPLE.issue}/${pageParam(SAMPLE.page)}/#${sampleArticle.id}`;
const sampleCitation = buildCitations({
  articleId: sampleArticle.id,
  title: sampleArticle.title,
  corpusTitle: sampleCorpus.title,
  issueDate: sampleIssue.issue_date,
  page: SAMPLE.page,
  url: new URL(sampleHref, Astro.site ?? "https://jyutman.com").href,
}).text;

const sections = [
  { id: "rights", label: "版權登記摘要" },
  { id: "cite", label: "引用本站" },
  { id: "api", label: "數據下載與 API" },
  { id: "takedown", label: "下架與更正" },
  { id: "corpora", label: "已發佈語料" },
];

const REPO = "https://github.com/huangjunxin";
const ISSUES_URL = `${REPO}/Jyutman/issues`;

/** 頁頭授權卡（連去各倉）；第四張「公有領域」唔係連結，寫喺模板。 */
const licences = [
  { tone: "amber", label: "站點代碼", value: "MIT", size: "xl", repo: "Jyutman" },
  { tone: "blue", label: "文本數據", value: "CC BY-SA 4.0", size: "lg", repo: "Jyutman-Corpus" },
  { tone: "green", label: "影像清單同來源登記", value: "見倉庫說明", size: "md", repo: "Jyutman-Images" },
] as const;

const steps = [
  { title: "收到通知", note: "經 GitHub Issues 提出" },
  { title: "先下架", note: "相關內容即時下架" },
  { title: "核證並記錄", note: "核證後記錄處理結果" },
];
---

<Base
  title="數據開放 · 粵語文叢"
  description="粵語文叢的授權安排：站點代碼 MIT、文本數據 CC BY-SA 4.0、底本屬公有領域；附版權登記摘要與下架聯絡。"
  current="data"
>
  <PageHero
    eyebrow="Open data · 數據開放"
    lead="站點代碼、文本數據、影像清單三者分開發佈，各自有清楚嘅授權；底本全部屬公有領域，但來源義務唔會因此消失。"
  >
    <Fragment slot="title">數據開放</Fragment>
    <GlassRow as="ul" class="licences">
      {
        licences.map((card) => (
          <li class="licences__slot">
            <Glass
              tone={card.tone}
              flush
              href={`${REPO}/${card.repo}`}
              target="_blank"
              rel="noopener"
              class="licence"
              paneClass="licence__pane"
            >
              <span class="licence__label">{card.label}</span>
              <span class={`licence__value licence__value--${card.size}`}>{card.value}</span>
              <span class="licence__foot">
                <span class="mono">{card.repo}</span>
                <Icon name="arrow-up-right" size={16} />
                <span class="visually-hidden">（新分頁開啟）</span>
              </span>
            </Glass>
          </li>
        ))
      }
      <li class="licences__slot">
        <Glass tone="ruby" flush class="licence" paneClass="licence__pane">
          <span class="licence__label">底本文獻 · 1842 至 1907 年出版物</span>
          <span class="licence__value licence__value--lg">公有領域</span>
          <span class="licence__foot licence__foot--plain">圖書館特藏 · Internet Archive</span>
        </Glass>
      </li>
    </GlassRow>
  </PageHero>

  <Longform sections={sections}>
    <section class="lf-section" id="rights">
      <div class="ordinal ordinal--lg">一</div>
      <h2 class="lf-h2">版權登記摘要</h2>
      <p class="lf-text">
        語料逐件登記底本年份、藏本、來源連結同版權判定，登記表放喺 <code>Jyutman-Corpus</code> 倉 <code>rights/</code>{" "}
        目錄（主表 <code>0.3-rights-registry.csv</code>、說明 <code>0.3-rights-summary.md</code>）。
      </p>
      <div class="rights">
        <div>
          <p class="rights__label label">首版登記結果</p>
          <p class="rights__count">
            <span class="rights__num">{RIGHTS_VERIFIED}</span>
            <span class="rights__total">/ {RIGHTS_TOTAL}</span>
            <span>個語料已核</span>
          </p>
        </div>
        <div class="rights__blocks" aria-hidden="true">
          {
            Array.from({ length: RIGHTS_TOTAL }, (_, index) => (
              <span class:list={["rights__block", { "rights__block--todo": index >= RIGHTS_VERIFIED }]} />
            ))
          }
        </div>
        <ul class="rights__legend">
          <li><span class="rights__swatch" aria-hidden="true"></span>已核 {RIGHTS_VERIFIED} 件</li>
          <li>
            <span class="rights__swatch rights__swatch--todo" aria-hidden="true"></span>待核 {RIGHTS_TOTAL - RIGHTS_VERIFIED} 件
          </li>
        </ul>
      </div>
      <ul class="points">
        <li>本站預設只公開 OCR 文本層；掃描影像要逐件核查藏館條款之後先會開放。</li>
        <li>研究語料庫（HKUST / EdUHK / PolyU 等）走合作授權，唔下載轉載。</li>
        <li>展示層逐葉標明底本來源同文本授權；現時 {totals.corpusCount} 個已發佈語料每葉都可追溯到來源。</li>
      </ul>
    </section>

    <section class="lf-section" id="cite">
      <div class="ordinal ordinal--lg">二</div>
      <h2 class="lf-h2">引用本站</h2>
      <p class="lf-text">葉級 URL 係引用主鍵，路徑唔會隨校對狀態改變。</p>
      <div class="anatomy" role="region" aria-label="葉級網址結構" tabindex="0">
        <p class="anatomy__row">
          <span class="anatomy__dim">jyutman.com/read/</span>
          <span class="anatomy__seg anatomy__seg--corpus"><span>{SAMPLE.corpus}</span><small>語料</small></span>
          <span class="anatomy__dim">/</span>
          <span class="anatomy__seg anatomy__seg--issue"><span>{SAMPLE.issue}</span><small>期號</small></span>
          <span class="anatomy__dim">/</span>
          <span class="anatomy__seg anatomy__seg--page"><span>{pageParam(1)}</span><small>葉碼（掃描序號）</small></span>
          <span class="anatomy__dim">/</span>
        </p>
      </div>
      <p class="lf-text">
        引用時請一併標明所引葉嘅底本、期號同年份（各葉「本葉來源」欄有齊）。閱讀頁「引用」欄可以直接複製文本、BibTeX、RIS 三種格式：
      </p>
      <pre class="citation">{sampleCitation}</pre>
      <a class="try" href={sampleHref}>喺閱讀頁試下 →</a>
    </section>

    <section class="lf-section" id="api">
      <div class="ordinal ordinal--lg">三</div>
      <h2 class="lf-h2">數據下載與 API</h2>
      <p class="lf-text">文本數據可以喺 Jyutman-Corpus 倉取得，授權 CC BY-SA 4.0；全量數據下載、開放 API 同 DOI 都未有。</p>
      <ul class="avail">
        <li class="avail__slot">
          <a class="avail__card avail__card--ok" href={`${REPO}/Jyutman-Corpus`} target="_blank" rel="noopener">
            <span class="badge badge--green">已可取得</span>
            <span class="avail__title">GitHub 倉庫</span>
            <span class="avail__repo">
              Jyutman-Corpus<Icon name="arrow-up-right" size={16} /><span class="visually-hidden">（新分頁開啟）</span>
            </span>
          </a>
        </li>
        {
          ["全量數據下載", "開放 API", "DOI"].map((item) => (
            <li class="avail__card">
              <span class="badge badge--amber">未有</span>
              <span class="avail__title">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="lf-section" id="takedown">
      <div class="ordinal ordinal--lg">四</div>
      <h2 class="lf-h2">下架與更正</h2>
      <p class="lf-text">如認為本站內容涉及版權、私隱或其他權益問題，歡迎喺 GitHub Issues 聯絡我哋。</p>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="steps__num">{String(index + 1).padStart(2, "0")}</span>
              <span class="steps__title">{step.title}</span>
              <span class="steps__note">{step.note}</span>
            </li>
          ))
        }
      </ol>
      <a class="btn btn--solid issues" href={ISSUES_URL} target="_blank" rel="noopener">
        <Icon name="github" />GitHub Issues<span class="visually-hidden">（新分頁開啟）</span>
      </a>
    </section>

    <section class="lf-section" id="corpora">
      <div class="ordinal ordinal--lg">五</div>
      <h2 class="lf-h2">現時已發佈語料</h2>
      <div class="table-wrap" role="region" aria-label="現時已發佈語料" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">語料</th>
              <th scope="col">年代</th>
              <th scope="col">葉數</th>
              <th scope="col">篇數</th>
              <th scope="col">底本來源</th>
            </tr>
          </thead>
          <tbody>
            {
              corpora.map((corpus, index) => (
                <tr>
                  <td>
                    <a class={`corpus-link tone-${corpusMeta(corpus, index).tone}`} href={`/browse/${corpus.slug}/`}>
                      <span class="corpus-link__bar" aria-hidden="true" />
                      {corpus.title}
                    </a>
                  </td>
                  <td class="year">{corpus.year ?? "待考"}</td>
                  <td>{corpus.pageCount}</td>
                  <td>{corpus.articleCount}</td>
                  <td class="source">{corpus.sourceLine}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </Longform>
</Base>

<style>
  /* 頁頭四張大號授權卡：共用木色容器（6px）；琥珀／寶藍／翠綠三張連去倉庫，寶石紅唔係連結 */
  .licences {
    margin-top: 48px;
  }

  .licences__slot {
    flex: 1 1 200px;
    min-height: 240px;
    display: flex;
  }

  .licence {
    flex: 1;
  }

  /* 卡唔係 .glass-row 直接子項，焦點框自己轉淺色先睇得見（木色底） */
  .licence:focus-visible {
    outline-color: var(--on-dark-72);
  }

  .licence__pane {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }

  .licence__label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--graphite);
  }

  .licence__value {
    line-height: 1.05;
  }

  .licence__value--xl {
    font-size: 48px;
  }

  .licence__value--lg {
    font-size: 36px;
  }

  .licence__value--md {
    font-size: 30px;
  }

  .licence__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .licence__foot--plain {
    color: var(--graphite);
  }

  /* 一、版權登記摘要：已核翠綠實心、待核琥珀虛線 */
  .rights {
    margin: 10px 0 28px;
    padding: 24px 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
    background: var(--surface);
  }

  .rights__label {
    margin: 0;
  }

  .rights__count {
    margin: 8px 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 17px;
  }

  .rights__num {
    font-family: var(--latin);
    font-size: 48px;
    font-weight: 300;
    line-height: 1;
    color: var(--green);
  }

  .rights__total {
    font-size: 28px;
    color: var(--graphite);
  }

  .rights__blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rights__block {
    width: 30px;
    height: 44px;
    background: var(--green);
  }

  .rights__legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }

  .rights__legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rights__swatch {
    flex: none;
    width: 10px;
    height: 10px;
    background: var(--green);
  }

  .rights__block--todo,
  .rights__swatch--todo {
    background: transparent;
    border: 1.5px dashed var(--amber-text);
  }

  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    line-height: 1.8;
  }

  .points li {
    display: flex;
    gap: 12px;
  }

  .points li::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 11px;
    background: var(--blue);
  }

  /* 二、葉級網址拆解：木色底，語料金黃、期號淺翠綠、葉碼紙白 */
  .anatomy {
    margin: 6px 0 26px;
    padding: 28px;
    background: var(--wood);
    color: var(--on-dark);
    overflow-x: auto;
  }

  .anatomy__row {
    margin: 0;
    display: flex;
    align-items: flex-start;
    font-family: var(--mono);
    font-size: clamp(14px, 1.7vw, 20px);
    line-height: 1.4;
    white-space: nowrap;
  }

  .anatomy__dim {
    color: color-mix(in srgb, var(--on-dark) 62%, transparent);
  }

  .anatomy__seg {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .anatomy__seg > span {
    padding-bottom: 6px;
    border-bottom: 3px solid var(--seg);
  }

  .anatomy__seg small {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--seg);
  }

  .anatomy__seg--corpus {
    --seg: var(--gold);
  }

  .anatomy__seg--issue {
    --seg: var(--green-glass);
  }

  .anatomy__seg--page {
    --seg: var(--on-dark);
  }

  .citation {
    margin: 0;
    padding: 16px 20px;
    background: var(--paper);
    border: 1px solid var(--line-10);
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .try {
    display: inline-block;
    margin-top: 12px;
    font-size: 17px;
    font-weight: 600;
  }

  /* 三、已可取得（紙面、翠綠頂邊）／未有（淺底、琥珀虛線） */
  .avail {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }

  .avail__slot {
    display: flex;
  }

  .avail__card {
    flex: 1;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px dashed var(--amber-a50);
    color: var(--wood);
  }

  .avail__card--ok {
    background: var(--paper);
    border: 1px solid var(--line-10);
    border-top: 4px solid var(--green);
    transition: background-color 200ms;
  }

  .avail__card--ok:hover {
    background: var(--surface);
    text-decoration: none;
  }

  .avail__title {
    display: block;
    margin-top: 12px;
    font-size: 22px;
  }

  .avail__repo {
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 15px;
    color: var(--blue);
  }

  /* 四、下架三步 */
  .steps {
    margin: 4px 0 24px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    padding: 22px;
    background: var(--surface);
  }

  .steps__num {
    font-family: var(--latin);
    font-size: 34px;
    font-weight: 300;
    line-height: 1;
    color: var(--blue);
  }

  .steps__title {
    margin-top: 10px;
    font-size: 21px;
  }

  .steps__note {
    margin-top: 4px;
    font-size: 16px;
    color: var(--graphite);
  }

  /* 原型 13px 24px 冇邊框；.btn 有 1px 透明邊，所以減 1px */
  .issues {
    gap: 10px;
    padding: 12px 23px;
  }

  /* 五、已發佈語料表 */
  /* 左右各留 4px 畀焦點框（2px + offset 2px），唔係會俾滾動容器裁走；負邊距抵銷，表格位置唔變 */
  .table-wrap {
    margin: 0 -4px;
    padding: 0 4px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-top: 2px solid var(--wood);
    min-width: 640px;
    border-collapse: collapse;
    font-size: 17px;
  }

  th {
    padding: 12px 16px 12px 0;
    text-align: left;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  tbody tr {
    border-top: 1px solid var(--line-10);
  }

  td {
    padding: 14px 16px 14px 0;
  }

  td.source {
    padding-right: 0;
    font-size: 15px;
    color: var(--graphite);
  }

  td.year {
    font-family: var(--latin);
    font-size: 19px;
  }

  .corpus-link {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 19px;
    line-height: 1.3;
    color: var(--wood);
  }

  .corpus-link__bar {
    flex: none;
    width: 8px;
    height: 30px;
    background: var(--tone);
  }
</style>
