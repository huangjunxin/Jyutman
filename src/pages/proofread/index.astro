---
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import { getCorpora, getIssues } from "../../utils/corpus.ts";
import { corpusMeta, issueLabel } from "../../utils/corpus-meta.ts";

// build time 注入位置標籤：語料 slug → 簡題、「slug/issue」→ 期號標籤（第一期／單冊）。
const labels = { titles: {} as Record<string, string>, issues: {} as Record<string, string> };
getCorpora().forEach((corpus, index) => {
  labels.titles[corpus.slug] = corpusMeta(corpus, index).shortTitle;
  for (const { issue } of getIssues(corpus.slug)) {
    labels.issues[`${corpus.slug}/${issue}`] = issueLabel(corpus.issueCount, issue);
  }
});

const tiles = [
  { status: "pending", label: "待審" },
  { status: "accepted", label: "已採用" },
  { status: "rejected", label: "已駁回" },
  { status: "deferred", label: "已暫緩" },
  { status: "", label: "全部" },
];
---

<Base
  title="校對工作台 · 粵語文叢"
  description="內部校對隊列：審閱讀者上報，採用、駁回或暫緩；唔對外開放。"
  noindex
>
  <div class="proof" id="proof" data-labels={JSON.stringify(labels)}>
    <section class="head">
      <div class="wrap head__inner">
        <div>
          <span class="badge badge--amber head__badge">內部工具 · 唔對外開放</span>
          <h1>校對工作台</h1>
          <p class="head__sub">匿名上報經此審閱 · 本站唔會直接回寫上游</p>
        </div>
        <div class="head__actions" id="actions" hidden>
          <button type="button" class="btn tool-btn" id="exportJson">導出已採用 JSON</button>
          <button type="button" class="btn tool-btn" id="exportCsv">導出已採用 CSV</button>
          <button type="button" class="btn text-btn" id="signOut">離開</button>
        </div>
      </div>
    </section>

    <section class="wrap gate" id="gate">
      <form class="gate__card" id="gateForm">
        <span class="gate__lock"><Icon name="lock" size={22} /></span>
        <h2>輸入維護密碼</h2>
        <p class="gate__hint" id="gateHint">
          輸入維護密碼（ADMIN_TOKEN）先可以讀取隊列；密碼只存喺本頁 session，閂咗分頁即清。
        </p>
        <label class="visually-hidden" for="gateInput">維護密碼</label>
        <input
          class="gate__input"
          type="password"
          id="gateInput"
          autocomplete="off"
          placeholder="維護密碼"
          required
          aria-describedby="gateHint"
        />
        <p class="gate__error" id="gateError" role="alert" hidden>密碼唔啱，或者伺服器未設定維護權杖。</p>
        <button type="submit" class="btn btn--solid gate__go">進入</button>
      </form>
    </section>

    <section class="wrap panel" id="panel" hidden>
      <div class="tiles" role="group" aria-label="狀態篩選">
        {
          tiles.map((tile) => (
            <button
              type="button"
              class={`tile tile--${tile.status || "all"}`}
              data-status={tile.status}
              aria-pressed={tile.status === "pending" ? "true" : "false"}
            >
              <span class="tile__n" data-count={tile.status}>…</span>
              <span class="tile__label">{tile.label}</span>
            </button>
          ))
        }
      </div>

      <div class="meta">
        <span>導出檔供人手整理之後向上游提 PR；本站唔會自動回寫上游。</span>
        <span class="meta__msg" id="msg" aria-live="polite"></span>
      </div>

      <p class="state" id="state" aria-live="polite" hidden></p>
      <div class="empty" id="empty" hidden>呢個狀態之下冇上報。</div>
      <div id="queue"></div>

      <template id="rowTpl">
        <article class="row">
          <div class="row__main">
            <div class="row__head">
              <span class="row__type" data-slot="type"></span>
              <span class="badge row__status" data-slot="status"></span>
              <span class="row__where" data-slot="where"></span>
              <time class="row__when" data-slot="when"></time>
            </div>
            <p class="row__frag" data-slot="frag"></p>
            <p class="row__sugg" data-slot="sugg"></p>
            <a class="row__go" data-slot="go">去原文 →</a>
          </div>
          <div class="row__actions">
            <button type="button" class="act act--accept" data-action="accept">採用</button>
            <button type="button" class="act act--reject" data-action="reject">駁回</button>
            <button type="button" class="act act--defer" data-action="defer">暫緩</button>
          </div>
        </article>
      </template>
    </section>
  </div>

  <script>
    const TOKEN_KEY = "jm-admin";
    const CSV_COLUMNS = ["id", "article_id", "corpus", "issue", "page", "type", "selected_text", "fragment", "suggestion", "created_at"];
    const STATUS_LABEL: Record<string, string> = {
      pending: "待審",
      accepted: "已採用",
      rejected: "已駁回",
      deferred: "已暫緩",
    };

    /** /api/queue 每一行（server/db/corrections.ts 嘅 QueueRow）。 */
    interface QueueItem {
      id: number;
      article_id: string;
      page_id: string | null;
      type: string;
      fragment: string | null;
      selected_text: string | null;
      suggestion: string | null;
      status: string;
      created_at: string;
      corpus: string | null;
      issue: string | null;
      page: number | null;
      [key: string]: unknown;
    }

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const root = $("proof");
    const gate = $("gate");
    const gateForm = $<HTMLFormElement>("gateForm");
    const gateInput = $<HTMLInputElement>("gateInput");
    const gateError = $("gateError");
    const panel = $("panel");
    const actions = $("actions");
    const queue = $("queue");
    const state = $("state");
    const empty = $("empty");
    const msg = $("msg");
    // 成功訊息翠綠，失敗訊息寶石紅（同檢索、報錯嘅送出失敗一致）
    const say = (text: string, error = false): void => {
      msg.textContent = text;
      msg.classList.toggle("meta__msg--error", error);
    };
    const rowTpl = $<HTMLTemplateElement>("rowTpl");
    const tiles = [...document.querySelectorAll<HTMLButtonElement>(".tile")];
    const labels: { titles: Record<string, string>; issues: Record<string, string> } = JSON.parse(
      root.dataset.labels ?? "{}",
    );

    let token = "";
    try {
      token = window.sessionStorage.getItem(TOKEN_KEY) ?? "";
    } catch {
      token = "";
    }
    let status = "pending";

    const setStored = (value: string | null): void => {
      try {
        if (value === null) window.sessionStorage.removeItem(TOKEN_KEY);
        else window.sessionStorage.setItem(TOKEN_KEY, value);
      } catch {
        /* 本機儲存唔可用時只保留今次 */
      }
    };

    const showGate = (error: boolean): void => {
      gate.hidden = false;
      panel.hidden = true;
      actions.hidden = true;
      gateError.hidden = !error;
      // 隱藏咗嘅錯誤訊息若仍被 aria-describedby 引用，讀屏會照讀，所以出錯先掛上。
      gateInput.setAttribute("aria-describedby", error ? "gateHint gateError" : "gateHint");
      if (error) gateInput.setAttribute("aria-invalid", "true");
      else gateInput.removeAttribute("aria-invalid");
      say("");
    };

    const showPanel = (): void => {
      gate.hidden = true;
      panel.hidden = false;
      actions.hidden = false;
    };

    const signOut = (error: boolean): void => {
      setStored(null);
      token = "";
      showGate(error);
      gateInput.focus();
    };

    /** 帶維護權杖請求；401 就登出並提示密碼錯，網絡錯誤返回 null。 */
    const authedFetch = async (url: string, options: RequestInit = {}): Promise<Response | null> => {
      const headers = new Headers(options.headers);
      headers.set("authorization", `Bearer ${token}`);
      const response = await fetch(url, { ...options, headers }).catch(() => null);
      if (response?.status === 401) {
        signOut(true);
        return null;
      }
      return response;
    };

    /** 讀取隊列；失敗返回 null。 */
    const fetchQueue = async (filter: string): Promise<QueueItem[] | null> => {
      const response = await authedFetch(`/api/queue?status=${encodeURIComponent(filter)}`);
      if (response === null || !response.ok) return null;
      const body: { items?: QueueItem[] } = await response.json().catch(() => ({}));
      return Array.isArray(body.items) ? body.items : null;
    };

    const pad3 = (page: number): string => String(page).padStart(3, "0");

    /** 本地時間 YYYY-MM-DD HH:MM；解析唔到就照出原字串。 */
    const formatTime = (iso: string): string => {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return iso;
      const z = (n: number) => String(n).padStart(2, "0");
      return `${date.getFullYear()}-${z(date.getMonth() + 1)}-${z(date.getDate())} ${z(date.getHours())}:${z(date.getMinutes())}`;
    };

    /** 位置：articles 左連冇結果時由 page_id（<corpus>/<issue>/<NNN>）推返。 */
    const locate = (item: QueueItem) => {
      const [pc, pi, pp] = (item.page_id ?? "").split("/");
      const corpus = item.corpus ?? (pc || null);
      const issue = item.issue ?? (pi || null);
      const page = item.page ?? (pp ? Number(pp) : null);
      const parts = [
        corpus === null ? "（語料未登記）" : (labels.titles[corpus] ?? corpus),
        issue === null || corpus === null ? null : (labels.issues[`${corpus}/${issue}`] ?? issue),
        page === null || Number.isNaN(page) ? null : `第 ${pad3(page)} 頁`,
        item.article_id,
      ];
      const href =
        corpus !== null && issue !== null && page !== null && !Number.isNaN(page)
          ? `/read/${corpus}/${issue}/${pad3(page)}/#${encodeURIComponent(item.article_id)}`
          : null;
      return { where: parts.filter((part) => part !== null).join(" · "), href };
    };

    const setStatusBadge = (badge: HTMLElement, value: string): void => {
      badge.dataset.status = value;
      badge.textContent = STATUS_LABEL[value] ?? value;
    };

    /** 由 template 砌一條；用戶內容一律 textContent。 */
    const renderRow = (item: QueueItem): HTMLElement => {
      const row = (rowTpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const slot = (name: string) => row.querySelector(`[data-slot="${name}"]`) as HTMLElement;
      row.dataset.id = String(item.id);

      slot("type").textContent = item.type;
      setStatusBadge(slot("status"), item.status);
      const { where, href } = locate(item);
      const whereNode = slot("where");
      whereNode.id = `report-${item.id}`;
      whereNode.textContent = where;
      const when = slot("when");
      when.setAttribute("datetime", item.created_at);
      when.textContent = formatTime(item.created_at);

      const frag = slot("frag");
      const fragment = item.fragment ?? "";
      const selected = item.selected_text ?? "";
      const at = selected ? fragment.indexOf(selected) : -1;
      if (at >= 0) {
        const mark = document.createElement("mark");
        mark.textContent = selected;
        frag.append(fragment.slice(0, at), mark, fragment.slice(at + selected.length));
      } else {
        frag.textContent = fragment || selected;
      }

      const sugg = slot("sugg");
      if (item.suggestion) sugg.textContent = `建議：${item.suggestion}`;
      else sugg.remove();

      const go = slot("go") as HTMLAnchorElement;
      if (href === null) go.remove();
      else go.href = href;

      for (const button of row.querySelectorAll("button")) button.setAttribute("aria-describedby", whereNode.id);
      return row;
    };

    const showState = (text: string, error = false): void => {
      state.textContent = text;
      state.classList.toggle("state--error", error);
      state.hidden = false;
    };

    // 序號防止慢回應蓋過較新嘅請求（快速切換篩選、連續裁決）。
    let countSeq = 0;
    let queueSeq = 0;

    const loadCounts = async (): Promise<void> => {
      const seq = ++countSeq;
      const items = await fetchQueue("");
      if (seq !== countSeq || items === null) return;
      // ponytail: /api/queue 有 LIMIT 200，計數只計最近 200 條，滿額時每格都標「+」做下限；隊列大過 200 要加 COUNT 端點。
      const capped = items.length >= 200;
      for (const node of root.querySelectorAll<HTMLElement>("[data-count]")) {
        const key = node.dataset.count ?? "";
        const n = key === "" ? items.length : items.filter((item) => item.status === key).length;
        node.textContent = capped ? `${n}+` : String(n);
      }
    };

    const loadQueue = async (): Promise<void> => {
      empty.hidden = true;
      queue.replaceChildren();
      showState("載入緊…");
      const seq = ++queueSeq;
      const items = await fetchQueue(status);
      if (seq !== queueSeq || token === "") return;
      if (items === null) {
        showState("資料載入失敗，請重新整理。", true);
        return;
      }
      state.hidden = true;
      queue.replaceChildren(...items.map(renderRow));
      empty.hidden = items.length > 0;
    };

    const adjudicate = async (row: HTMLElement, action: string): Promise<void> => {
      const response = await authedFetch("/api/adjudicate", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ id: Number(row.dataset.id), action }),
      });
      if (response === null) {
        if (token !== "") say("操作失敗，請再試。", true);
        return;
      }
      if (!response.ok) {
        say("操作失敗，請再試。", true);
        return;
      }
      const body: { status?: string } = await response.json().catch(() => ({}));
      const next = body.status ?? "";
      setStatusBadge(row.querySelector<HTMLElement>('[data-slot="status"]') as HTMLElement, next);
      if (status !== "" && next !== status) {
        row.remove();
        empty.hidden = queue.childElementCount > 0;
      }
      say("");
      void loadCounts();
    };

    queue.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>("button[data-action]") : null;
      const row = button?.closest<HTMLElement>(".row");
      if (button && row && button.dataset.action) void adjudicate(row, button.dataset.action);
    });

    for (const tile of tiles) {
      tile.addEventListener("click", () => {
        status = tile.dataset.status ?? "";
        for (const other of tiles) other.setAttribute("aria-pressed", String(other === tile));
        void loadQueue();
      });
    }

    const enter = (): void => {
      showPanel();
      void loadCounts();
      void loadQueue();
    };

    gateForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = gateInput.value.trim();
      if (value === "") {
        showGate(true);
        gateInput.focus();
        return;
      }
      token = value;
      setStored(value);
      gateInput.value = "";
      enter();
      // 送出後「進入」掣隱藏，焦點移去當前篩選格，免得跌返 <body>。
      tiles.find((tile) => tile.getAttribute("aria-pressed") === "true")?.focus();
    });

    const download = (name: string, mime: string, text: string): void => {
      const url = URL.createObjectURL(new Blob([text], { type: mime }));
      const link = document.createElement("a");
      link.href = url;
      link.download = name;
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    const csvCell = (value: unknown): string => `"${String(value ?? "").replaceAll('"', '""')}"`;

    const exportAccepted = async (kind: "json" | "csv"): Promise<void> => {
      const items = await fetchQueue("accepted");
      if (items === null) {
        if (token !== "") say("導出失敗，請再試。", true);
        return;
      }
      const text =
        kind === "json"
          ? `${JSON.stringify(items, null, 2)}\n`
          : `${[CSV_COLUMNS.join(","), ...items.map((item) => CSV_COLUMNS.map((column) => csvCell(item[column])).join(","))].join("\n")}\n`;
      download(`jyutman-corrections-accepted.${kind}`, kind === "json" ? "application/json" : "text/csv", text);
      say(`已導出 ${items.length} 條已採用上報（${kind.toUpperCase()}）`);
    };

    $("exportJson").addEventListener("click", () => void exportAccepted("json"));
    $("exportCsv").addEventListener("click", () => void exportAccepted("csv"));
    $("signOut").addEventListener("click", () => signOut(false));

    if (token === "") showGate(false);
    else enter();
  </script>

  <style>
    /* 頁頭 */
    .head {
      border-bottom: 1px solid var(--line-10);
    }

    .head__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px 32px;
      padding-top: clamp(40px, 5vw, 72px);
      padding-bottom: 28px;
    }

    .head__badge {
      padding: 3px 10px;
      letter-spacing: 0.12em;
    }

    h1 {
      margin-top: 16px;
      font-size: clamp(40px, 4.4vw, 56px);
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .head__sub {
      margin: 14px 0 0;
      color: var(--graphite);
    }

    .head__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tool-btn,
    .text-btn {
      padding: 9px 16px;
      font-size: 16px;
    }

    .tool-btn {
      border-color: rgba(30, 21, 18, 0.25);
      background: var(--paper);
    }

    .tool-btn:hover {
      background: var(--surface);
    }

    .text-btn {
      border: 0;
      color: var(--graphite);
    }

    .text-btn:hover {
      color: var(--blue);
    }

    /* 密碼頁 */
    .gate {
      display: flex;
      justify-content: center;
      padding-top: clamp(48px, 6vw, 88px);
      padding-bottom: 120px;
    }

    .gate__card {
      width: 100%;
      max-width: 520px;
      padding: clamp(28px, 4vw, 44px);
      border: 1px solid var(--line-12);
      background: var(--paper);
    }

    .gate__lock {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      background: var(--wood);
      color: var(--on-dark);
    }

    h2 {
      margin-top: 22px;
      font-size: 30px;
      line-height: 1.2;
    }

    .gate__hint {
      margin: 10px 0 0;
      font-size: 16px;
      line-height: 1.8;
      color: var(--graphite);
    }

    .gate__input {
      display: block;
      width: 100%;
      height: 52px;
      margin-top: 22px;
      padding: 0 16px;
      border: 2px solid var(--wood);
      background: var(--surface-2);
      font-family: var(--mono);
      font-size: 18px;
    }

    .gate__error {
      margin: 10px 0 0;
      font-size: 15px;
      color: var(--blue);
    }

    .gate__go {
      width: 100%;
      height: 52px;
      margin-top: 14px;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.1em;
    }

    /* 已登入：狀態格 */
    .panel {
      padding-top: 28px;
      padding-bottom: 96px;
    }

    .tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
    }

    .tile {
      --n: var(--wood);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 18px 20px;
      border: 1px solid var(--line-12);
      background: var(--paper);
      text-align: left;
      cursor: pointer;
      transition:
        background-color 200ms,
        border-color 200ms,
        color 200ms;
    }

    .tile:hover {
      background: var(--surface);
    }

    .tile--pending {
      --n: var(--blue);
    }

    .tile--accepted {
      --n: var(--green);
    }

    .tile--rejected {
      --n: var(--graphite);
    }

    .tile--deferred {
      --n: var(--amber-text);
    }

    .tile[aria-pressed="true"] {
      --n: var(--on-dark);
      border-color: var(--wood);
      background: var(--wood);
      color: var(--on-dark);
    }

    .tile__n {
      font-family: var(--latin);
      font-size: 36px;
      font-weight: 300;
      line-height: 1;
      color: var(--n);
    }

    .tile__label {
      font-size: 16px;
      font-weight: 600;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px 24px;
      margin: 20px 0 4px;
      font-size: 15px;
      color: var(--graphite);
    }

    /* 頁面底上翠綠字唔夠 4.5:1，用 --green-text */
    .meta__msg {
      font-weight: 600;
      color: var(--green-text);
    }

    /* 空嘅 live region 抽出 flex 排版：唔開新行、唔食 row-gap，但仍留喺無障礙樹 */
    .meta__msg--error {
      color: var(--ruby);
    }

    .meta__msg:empty {
      position: absolute;
    }

    .state {
      margin: 40px 0 0;
      text-align: center;
      font-size: 24px;
      color: var(--graphite);
    }

    .state--error {
      color: var(--blue);
    }

    .empty {
      margin-top: 20px;
      padding: 40px 24px;
      border: 1px dashed var(--line-20);
      background: var(--surface);
      text-align: center;
      font-size: 16px;
      color: var(--graphite);
    }

    /* 隊列每條 */
    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 16px 32px;
      padding: 22px 0;
      border-bottom: 1px solid var(--line-10);
    }

    .row__main {
      flex: 1 1 520px;
      min-width: 0;
    }

    .row__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
    }

    .row__type {
      padding: 1px 10px;
      border: 1px solid var(--blue);
      color: var(--blue);
      font-size: 14px;
      font-weight: 700;
    }

    .row__status {
      padding: 2px 10px;
      font-weight: 700;
    }

    .row__status[data-status="pending"] {
      background: var(--blue-a10);
      color: var(--blue);
