---
import type { GetStaticPaths } from "astro";

import Eyebrow from "../../../../components/Eyebrow.astro";
import Glass from "../../../../components/Glass.astro";
import JsonLd from "../../../../components/JsonLd.astro";
import StatusBadge from "../../../../components/StatusBadge.astro";
import Base from "../../../../layouts/Base.astro";
import { buildCitations } from "../../../../utils/citation.ts";
import { issueLabel, issueNumeral } from "../../../../utils/corpus-meta.ts";
import {
  getCorpus,
  getFirstReadablePage,
  getIssue,
  getIssues,
  getIssueToc,
  getJyutping,
  getPage,
  getPageRoutes,
  getPages,
  getTranslations,
} from "../../../../utils/corpus.ts";
import {
  isCjkDominant,
  markerNote,
  mergeParagraphSpans,
  pageParam,
  pairTranslations,
  readingsByIndex,
  splitParagraphSpans,
  statusBadge,
  withoutTranslations,
} from "../../../../utils/reader.ts";
import { CORRECTION_TYPES, renderParagraphSegments, renderTranslation } from "../../../../utils/reader-view.ts";

export const getStaticPaths = (() =>
  getPageRoutes().map((route) => ({
    params: { corpus: route.corpus, issue: route.issue, page: pageParam(route.page) },
    props: { route },
  }))) satisfies GetStaticPaths;

const { route } = Astro.props;
const { corpus: corpusSlug, issue: issueSlug, page: pageNumber } = route;

const corpus = getCorpus(corpusSlug);
const issue = getIssue(corpusSlug, issueSlug);
const leaf = getPage(corpusSlug, issueSlug, pageNumber);
if (!corpus || !issue || !leaf) {
  throw new Error(`找唔到頁：${corpusSlug}/${issueSlug}/${pageNumber}`);
}

const pages = getPages(corpusSlug, issueSlug);
const index = pages.findIndex((record) => record.page === pageNumber);
const previous = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;

const readUrl = (issueKey: string, page: number) => `/read/${corpusSlug}/${issueKey}/${pageParam(page)}/`;
const pageNo = pageParam(pageNumber);
const issueText = issueLabel(corpus.issueCount, issueSlug);
const dateText = issue.issue_date ?? "日期待考";
const badge = statusBadge(leaf.status);

/** 期號切換（多期語料先有）：每期跳去首個可讀頁。 */
const issueLinks =
  corpus.issueCount > 1
    ? getIssues(corpusSlug).map((record) => ({
        href: readUrl(record.issue, getFirstReadablePage(corpusSlug, record.issue)),
        numeral: issueNumeral(record.issue),
        date: record.issue_date?.slice(5) ?? "待考",
        full: `${issueLabel(corpus.issueCount, record.issue)}（${record.issue_date ?? "日期待考"}）`,
        current: record.issue === issueSlug,
      }))
    : [];

/** 期號篇目；當前篇 = 頁碼 ≤ 本頁嘅最後一條。 */
const toc = getIssueToc(corpusSlug, issueSlug);
const currentToc = toc.findLastIndex((entry) => entry.page <= pageNumber);

const jyutping = getJyutping(corpusSlug, issueSlug);
const translations = getTranslations(corpusSlug, issueSlug);

interface ParagraphView {
  html: string;
  /** 該組今譯 HTML（譯註已包好）；冇譯文為 null。 */
  translation: string | null;
}

interface ArticleView {
  kind: "article";
  id: string;
  title: string | null;
  /** 唔係漢文為主（漢字唔多過拉丁字母）嘅篇章一律橫排。 */
  latin: boolean;
  paragraphs: ParagraphView[];
  /** 譯文段數對唔上：跳過今譯，喺 HTML 註釋標記。 */
  translationMismatch: boolean;
  /** 第一段有譯文嘅組序（逐段今譯只喺呢段出標頭）；冇譯文為 -1。 */
  firstTranslated: number;
}

interface MarkerView {
  kind: "marker";
  text: string;
  note: string | null;
}

const views: (ArticleView | MarkerView)[] = leaf.blocks.map((block) => {
  if (block.type !== "article") return { kind: "marker", text: block.text, note: markerNote(block.text) };
  const groups = mergeParagraphSpans(splitParagraphSpans(block.text));
  const paired = pairTranslations(groups, translations[block.id]?.paragraphs);
  if (paired === null) console.warn(`今譯段數對唔上，已跳過：${block.id}`);
  const readings = readingsByIndex(jyutping[block.id]);
  const paragraphs = (paired ?? withoutTranslations(groups)).map((entry) => ({
    html: renderParagraphSegments(entry.paragraph, readings),
    translation: entry.translation ? renderTranslation(entry.translation) : null,
  }));
  return {
    kind: "article",
    id: block.id,
    title: block.title,
    latin: !isCjkDominant(block.text),
    paragraphs,
    translationMismatch: paired === null,
    firstTranslated: paragraphs.findIndex((paragraph) => paragraph.translation !== null),
  };
});

const hasTranslation = views.some((view) => view.kind === "article" && view.firstTranslated >= 0);

const siteUrl = (Astro.site ?? new URL("https://jyutman.com")).href;
const leafUrl = `${siteUrl}read/${corpusSlug}/${issueSlug}/${pageNo}/`;

/** 頁名取首篇文章題目；無題或題目同書名相同時，只用書名。 */
const firstArticle = leaf.blocks.find((block) => block.type === "article");
const leafTitle = firstArticle?.type === "article" ? firstArticle.title : null;
const pageName = leafTitle !== null && leafTitle !== corpus.title ? `${leafTitle} · ${corpus.title}` : corpus.title;

/** 引用本頁第一篇文章。 */
const citations =
  firstArticle?.type === "article"
    ? buildCitations({
        articleId: firstArticle.id,
        title: firstArticle.title,
        corpusTitle: corpus.title,
        issueDate: issue.issue_date,
        page: pageNumber,
        url: `${leafUrl}#${firstArticle.id}`,
      })
    : null;

const citeFormats = citations
  ? [
      { key: "text", label: "文本", body: citations.text },
      { key: "bibtex", label: "BibTeX", body: citations.bibtex },
      { key: "ris", label: "RIS", body: citations.ris },
    ]
  : [];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: leafTitle !== null && leafTitle !== corpus.title ? leafTitle : `${corpus.title} 第 ${pageNo} 頁`,
  isPartOf: {
    "@type": "Book",
    name: corpus.title,
    url: `${siteUrl}browse/${corpus.slug}/`,
  },
  ...(issue.issue_date !== null ? { datePublished: issue.issue_date } : {}),
  inLanguage: "zh-Hant",
  license: "https://creativecommons.org/licenses/by-sa/4.0/",
  url: leafUrl,
};
---

<Base
  title={`${pageName} · 第 ${pageNo} 頁 · 粵語文叢`}
  description={`${corpus.title}${issue.issue_date ? `（${issue.issue_date}）` : ""}第 ${pageNo} 頁的 OCR 文本，附底本來源、OCR 狀態與文本授權。`}
  current="browse"
>
  <Fragment slot="head">
    <script is:inline>
      // 閱讀偏好喺首次渲染之前落 class（rd-h 橫排、rd-nojp 唔注音、rd-notr 唔出今譯），冇閃爍。
      (function () {
        try {
          var prefs = JSON.parse(window.localStorage.getItem("jyutman:reader-prefs") || "{}") || {};
          var list = document.documentElement.classList;
          if (prefs.layout === "horizontal") list.add("rd-h");
          if (prefs.jp === false) list.add("rd-nojp");
          if (prefs.tr === false) list.add("rd-notr");
        } catch (error) {
          /* 本機儲存唔可用：用預設（豎排、開粵拼、開今譯） */
        }
      })();
    </script>
    <JsonLd data={articleJsonLd} />
  </Fragment>

  <div class="rd-toolbar" id="rd-toolbar">
    <div class="rd-toolbar__inner">
      <nav class="crumb" aria-label="位置">
        <a href="/browse/">書目庫</a><span aria-hidden="true">›</span>
        <a href={`/browse/${corpus.slug}/`}>{corpus.title}</a><span aria-hidden="true">›</span>
        <span>{issueText}（{dateText}）</span><span aria-hidden="true">›</span>
        <span class="crumb__cur" aria-current="page">第 {pageNo} 頁</span>
      </nav>
      <div class="rd-controls">
        <button type="button" class="chip chip--hl" id="hl-chip" hidden></button>
        <span class="label" id="rd-layout-label">行款</span>
        <div class="seg" role="group" aria-labelledby="rd-layout-label">
          <button type="button" data-layout="vertical" aria-pressed="true">豎排</button>
          <button type="button" data-layout="horizontal" aria-pressed="false">橫排</button>
        </div>
        <button type="button" class="toggle" data-pref="jp" aria-pressed="true">粵拼注音</button>
        {
          hasTranslation ? (
            <button type="button" class="toggle" data-pref="tr" aria-pressed="true">
              今譯
            </button>
          ) : (
            <button type="button" class="toggle" aria-pressed="false" disabled title="本頁冇今譯">
              今譯
            </button>
          )
        }
      </div>
    </div>
  </div>
  <script is:inline>
    // 開關狀態跟返 <html> 上嘅偏好 class（同步執行，避免掣先亮錯再跳）。
    (function () {
      var list = document.documentElement.classList;
      document.querySelectorAll("#rd-toolbar [data-layout]").forEach(function (button) {
        button.setAttribute("aria-pressed", String((button.dataset.layout === "horizontal") === list.contains("rd-h")));
      });
      document.querySelectorAll("#rd-toolbar [data-pref]").forEach(function (button) {
        button.setAttribute("aria-pressed", String(!list.contains("rd-no" + button.dataset.pref)));
      });
    })();
  </script>

  <div class="rd-grid">
    <aside class="rd-toc" id="rd-toc" aria-label="目錄">
      <div class="toc-head">
        <Eyebrow size="sm" text="Contents · 目錄" />
        <p class="toc-title">{corpus.title}</p>
        <p class="toc-meta">{issueText} · {dateText} · {pages.length} 頁</p>
        {
          issueLinks.length > 0 && (
            <nav class="issue-switch" aria-label="期號">
              {issueLinks.map((link) => (
                <a href={link.href} title={link.full} aria-label={link.full} aria-current={link.current ? "true" : undefined}>
                  <span class="issue-switch__num">{link.numeral}</span>
                  <span class="issue-switch__date">{link.date}</span>
                </a>
              ))}
            </nav>
          )
        }
        {
          toc.length > 0 && (
            <button
              type="button"
              class="toc-toggle"
              aria-expanded="false"
              aria-controls="toc-list"
              data-closed-label={`展開目錄（${toc.length} 篇）`}
            >
              展開目錄（{toc.length} 篇）
            </button>
          )
        }
      </div>
      {
        toc.length > 0 && (
          <ol class="toc-list" id="toc-list">
            {toc.map((entry, i) => (
              <li>
                <a
                  class:list={["toc-item", i === currentToc && "is-current"]}
                  href={`${readUrl(issueSlug, entry.page)}#${entry.id}`}
                  aria-current={i === currentToc ? "true" : undefined}
                >
                  <span class="toc-num">{pageParam(entry.page)}</span>
                  <span>{entry.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </aside>

    <article class="rd-card">
      <header class="card-head">
        <h1 class="leaf-no">
          <span class="visually-hidden">{corpus.title}</span>
          <span class="leaf-no__num">{pageNo}</span>
          <span class="leaf-no__pos">頁 · 第 {index + 1} / {pages.length} 頁</span>
        </h1>
        <StatusBadge status={leaf.status} size="md" label={badge.tone === "ok" ? undefined : "OCR 未校 · 歡迎報錯"} />
      </header>

      <div class="card-body" id="rd-body">
        {
          views.map((view) =>
            view.kind === "article" ? (
              <section class:list={["art", view.latin ? "art--latin" : "art--cjk"]} id={view.id} data-article>
                <header class:list={["art-head", view.title === null && "art-head--bare"]}>
                  {view.title !== null && <h2 class="art-title">{view.title}</h2>}
                  <a class="art-anchor" href={`#${view.id}`} data-copy-anchor title="撳一下複製本篇連結">
                    #{view.id}
                  </a>
                </header>
                {view.translationMismatch && <Fragment set:html={`<!-- 今譯段數對唔上，已跳過：${view.id} -->`} />}
                {view.paragraphs.length === 0 ? (
                  <p class="art-empty">（呢篇冇正文）</p>
                ) : (
                  <div class="art-text">
                    <div class="art-flow" tabindex="0" role="region" aria-label={`${view.title ?? view.id} 正文`}>
                      {view.paragraphs.map((paragraph, i) => (
                        <Fragment>
                          <p class="para" data-pi={i} set:html={paragraph.html} />
                          {paragraph.translation !== null && (
                            <div class="tr tr-inline">
                              {i === view.firstTranslated && (
                                <div class="tr-head">
                                  <span class="tr-tag">今譯 · Modern Cantonese</span>
                                  <span class="tr-ver">譯 v0 · 未校訂</span>
                                </div>
                              )}
                              <p data-pi={i} set:html={paragraph.translation} />
                            </div>
                          )}
                        </Fragment>
                      ))}
                    </div>
                  </div>
                )}
                {view.firstTranslated >= 0 && (
                  <div class="tr tr-whole">
                    <div class="tr-head">
                      <span class="tr-tag">今譯 · Modern Cantonese</span>
                      <span class="tr-ver">譯 v0 · 未校訂</span>
                    </div>
                    {view.paragraphs.map(
                      (paragraph, i) =>
                        paragraph.translation !== null && <p data-pi={i} set:html={paragraph.translation} />,
                    )}
                  </div>
                )}
              </section>
            ) : (
              <div class="ph">
                <span class="ph__text">{view.text}</span>
                {view.note !== null && <span class="ph__note">{view.note}</span>}
              </div>
            ),
          )
        }
      </div>

      <footer class="card-foot">
        {
          previous ? (
            <a class="btn btn--neutral pg pg--prev" href={readUrl(issueSlug, previous.page)} rel="prev" data-nav="prev">
              ‹ 上一頁
            </a>
          ) : (
            <a class="btn btn--neutral pg pg--prev" role="link" aria-disabled="true">
              ‹ 上一頁
            </a>
          )
        }
        <p class="pg-info">
          掃描序號 <b>{pageNo}</b> · <span class="pg-pos">第 {index + 1} / {pages.length} 頁</span><br />
          <span class="pg-hint">← → 鍵都可以揭頁</span>
        </p>
        {
          next ? (
            <a class="btn btn--solid pg pg--next" href={readUrl(issueSlug, next.page)} rel="next" data-nav="next">
              下一頁 ›
            </a>
          ) : (
            <a class="btn btn--solid pg pg--next" role="link" aria-disabled="true">
              下一頁 ›
            </a>
          )
        }
      </footer>
    </article>

    <aside class="rd-side" aria-label="本頁資料">
      <Glass tone="neutral" as="section" paneClass="src-pane" aria-labelledby="src-title">
        <h2 id="src-title">本頁來源</h2>
        <dl class="src-list">
          <dt>語料</dt>
          <dd><a href={`/browse/${corpus.slug}/`}>{corpus.title}</a></dd>
          <dt>期號</dt>
          <dd>{issueText}（{dateText}）</dd>
          <dt>頁序號</dt>
          <dd class="mono">{pageNo}</dd>
          <dt>OCR 狀態</dt>
          <dd>{badge.label}</dd>
          <dt>底本來源</dt>
          <dd>{corpus.sourceLine}</dd>
          <dt>文本授權</dt>
          <dd>CC BY-SA 4.0</dd>
        </dl>
      </Glass>

      {
        citations && (
          <Glass tone="neutral" as="section" paneClass="cite-pane" aria-labelledby="cite-title">
            <div class="cite-head">
              <h2 id="cite-title">引用</h2>
              <button type="button" class="btn btn--outline btn--sm cite-copy" id="cite-copy">
                複製
              </button>
            </div>
            <div class="cite-tabs" role="tablist" aria-label="引用格式">
              {citeFormats.map((format, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`cite-tab-${format.key}`}
                  aria-controls={`cite-panel-${format.key}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {format.label}
                </button>
              ))}
            </div>
            {citeFormats.map((format, i) => (
              <pre
                class="cite-pre"
                role="tabpanel"
                id={`cite-panel-${format.key}`}
                aria-labelledby={`cite-tab-${format.key}`}
                tabindex="0"
                hidden={i !== 0}
                set:text={format.body}
              />
            ))}
          </Glass>
        )
      }

      {
        firstArticle && (
          <Glass tone="neutral" as="section" paneClass="rp-pane" aria-labelledby="rp-title">
            <h2 id="rp-title">報錯</h2>
            <form class="rp-form" id="rp-form" novalidate>
              <p class="rp-hint" id="rp-hint" tabindex="-1">喺正文揀選有問題嘅字，就會自動帶入呢度。</p>
              <p class="rp-sel" id="rp-sel" hidden />
              <fieldset class="rp-types">
                <legend>問題類型</legend>
                <div class="rp-chips">
                  {CORRECTION_TYPES.map((type) => (
                    <label class="rp-chip">
                      <input class="visually-hidden" type="radio" name="type" value={type} />
                      <span class="rp-type">{type}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <label class="visually-hidden" for="rp-note">
                建議讀法或說明（選填）
              </label>
              <textarea class="rp-note" id="rp-note" name="suggestion" rows="3" maxlength="1000" placeholder="建議讀法或說明（選填）" />
              <div class="rp-hp" aria-hidden="true">
                <label>
                  網址（唔好填）
                  <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button type="submit" class="btn btn--solid rp-submit" id="rp-submit" disabled>
                揀選正文同問題類型先可以提交
              </button>
              <p class="rp-error" id="rp-error" role="alert" hidden />
              <p class="rp-foot">匿名上報，唔會收集任何聯繫方式；提交後由維護者人工審閱。</p>
            </form>
            <div class="rp-done" id="rp-done" hidden>
              <p class="rp-ok" tabindex="-1">多謝！已經收到你嘅上報，維護者會人工審閱。</p>
              <button type="button" class="btn btn--neutral btn--sm rp-again" id="rp-again">
                再報一個
              </button>
            </div>
          </Glass>
        )
      }
    </aside>
  </div>

  <div class="dict-card" id="dict-card" hidden>
    <p class="dict-card__word" id="dict-word"></p>
    <a class="dict-card__link" id="dict-link" href="https://jyutjyu.com/" target="_blank" rel="noopener">去辭叢查</a>
    <p class="dict-card__hint">釋義以辭叢為準</p>
  </div>
  <p class="visually-hidden" id="rd-live" role="status"></p>

  <script>
    import { wordAround } from "../../../../utils/reader.ts";
    import {
      clipText,
      fragmentAround,
      highlightRanges,
      selectionSpan,
      type SelectionPiece,
    } from "../../../../utils/reader-view.ts";

    const root = document.documentElement;
    const body = document.getElementById("rd-body");
    const live = document.getElementById("rd-live");

    const announce = (message: string): void => {
      if (live === null) return;
      live.textContent = "";
      window.setTimeout(() => (live.textContent = message), 60);
    };

    const elementOf = (node: Node | null): Element | null =>
      node === null ? null : node instanceof Element ? node : node.parentElement;

    /** scope 之內嘅文字節點；skip 命中嘅祖先（例如 rt）唔要。 */
    const textNodes = (scope: Node, skip: string): Text[] => {
      const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      for (let node = walker.nextNode(); node !== null; node = walker.nextNode()) {
        if (node.parentElement?.closest(skip) == null) nodes.push(node as Text);
      }
      return nodes;
    };

    /** 可見文字（skip 命中嘅唔計，預設剔走粵拼），空白收窄（唔去頭尾）。 */
    const flatText = (scope: Node, skip = "rt"): string =>
      textNodes(scope, skip)
        .map((node) => node.data)
        .join("")
        .replace(/\s+/gu, " ");

    /** 按 nodes 串埋之後嘅 UTF-16 區間，逐個文字節點包一層（字喺 <ruby> 入面，唔可以成段包）。 */
    const wrapRanges = (nodes: Text[], ranges: [number, number][], make: () => HTMLElement): HTMLElement[] => {
      const pieces: { node: Text; from: number; to: number }[] = [];
      let base = 0;
      for (const node of nodes) {
        const end = base + node.data.length;
        for (const [start, stop] of ranges) {
          const from = Math.max(start, base);
          const to = Math.min(stop, end);
          if (from < to) pieces.push({ node, from: from - base, to: to - base });
        }
        base = end;
      }
      const made: HTMLElement[] = [];
      // 由尾向頭切，前面嘅下標唔會因為 splitText 而走位。
      for (const piece of pieces.reverse()) {
        const target = piece.from > 0 ? piece.node.splitText(piece.from) : piece.node;
        if (piece.to - piece.from < target.data.length) target.splitText(piece.to - piece.from);
        const element = make();
        target.replaceWith(element);
        element.append(target);
        made.unshift(element);
      }
      return made;
    };

    /* ---- 閱讀偏好：行款、粵拼、今譯（存 localStorage） ---- */

    const syncControls = (): void => {
      const horizontal = root.classList.contains("rd-h");
      for (const button of document.querySelectorAll<HTMLButtonElement>("#rd-toolbar [data-layout]")) {
        button.setAttribute("aria-pressed", String((button.dataset.layout === "horizontal") === horizontal));
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>("#rd-toolbar [data-pref]")) {
        button.setAttribute("aria-pressed", String(!root.classList.contains(`rd-no${button.dataset.pref}`)));
      }
    };

    const savePrefs = (): void => {
      try {
        window.localStorage.setItem(
          "jyutman:reader-prefs",
          JSON.stringify({
            layout: root.classList.contains("rd-h") ? "horizontal" : "vertical",
            jp: !root.classList.contains("rd-nojp"),
            tr: !root.classList.contains("rd-notr"),
          }),
        );
      } catch {
        /* 本機儲存唔可用：切換只作用於今次瀏覽 */
      }
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>("#rd-toolbar [data-layout]")) {
      button.addEventListener("click", () => {
        root.classList.toggle("rd-h", button.dataset.layout === "horizontal");
        syncControls();
        savePrefs();
      });
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>("#rd-toolbar [data-pref]")) {
      button.addEventListener("click", () => {
        root.classList.toggle(`rd-no${button.dataset.pref}`);
        syncControls();
        savePrefs();
      });
    }
    syncControls();

    /* ---- 黏頂：工具列高度寫入 --toolbar-h，側欄同錨點避開佢 ---- */

    const toolbar = document.getElementById("rd-toolbar");
    if (toolbar !== null && "ResizeObserver" in window) {
      new ResizeObserver(() => root.style.setProperty("--toolbar-h", `${toolbar.offsetHeight}px`)).observe(toolbar);
    }

    /* ---- 目錄：闊螢幕側欄自己捲到當前篇；窄螢幕開合 ---- */

    const tocAside = document.getElementById("rd-toc");
    const tocCurrent = tocAside?.querySelector<HTMLElement>(".toc-item.is-current");
    if (tocAside && tocCurrent && tocCurrent.offsetTop + tocCurrent.offsetHeight > tocAside.clientHeight) {
      // 卡頭黏頂會遮住上面：當前篇擺喺卡頭以下嘅三分一位
      const head = tocAside.querySelector<HTMLElement>(".toc-head")?.offsetHeight ?? 0;
      tocAside.scrollTop = tocCurrent.offsetTop - head - (tocAside.clientHeight - head) / 3;
    }

    const tocToggle = document.querySelector<HTMLButtonElement>(".toc-toggle");
    tocToggle?.addEventListener("click", () => {
      const open = tocAside?.classList.toggle("is-open") ?? false;
      tocToggle.setAttribute("aria-expanded", String(open));
      tocToggle.textContent = open ? "收埋目錄" : (tocToggle.dataset.closedLabel ?? "展開目錄");
    });

    /* ---- ← → 揭頁（同一期之內） ---- */

    // 豎排正文可以 Tab 入去用 ← → 捲；滑鼠撳字（會聚焦正文）唔算，← → 照揭頁。
    let tabbed = false;
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Tab") tabbed = true;
      },
      true,
    );
    document.addEventListener("pointerdown", () => (tabbed = false), true);

    document.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const target = event.target;
      const flow = target instanceof HTMLElement ? target.closest(".art-flow") : null;
      if (
        target instanceof HTMLElement &&
        (target.isContentEditable ||
          target.closest("input, textarea, select, [role='tab'], .cite-pre") !== null ||
          (tabbed && flow !== null && flow.scrollWidth > flow.clientWidth))
      ) {
        return;
      }
      const link = document.querySelector<HTMLAnchorElement>(
        `a[data-nav="${event.key === "ArrowLeft" ? "prev" : "next"}"]`,
      );
      if (link === null) return;
      event.preventDefault();
      window.location.href = link.href;
    });

    /* ---- 篇級錨點：照跳，同時複製絕對連結 ---- */

    for (const anchor of document.querySelectorAll<HTMLAnchorElement>("a[data-copy-anchor]")) {
      anchor.addEventListener("click", () => {
        const url = `${window.location.origin}${window.location.pathname}${anchor.hash}`;
        navigator.clipboard?.writeText(url).then(
          () => {
            anchor.classList.add("is-copied");
            announce("已複製本篇連結");
            window.setTimeout(() => anchor.classList.remove("is-copied"), 1600);
          },
          () => undefined,
        );
      });
    }

    /* ---- 引用：分頁同複製 ---- */

    const citeCopy = document.getElementById("cite-copy");
    const citeTabs = [...document.querySelectorAll<HTMLButtonElement>('.cite-tabs [role="tab"]')];
    let citeActive = 0;

    const selectCite = (next: number, focus: boolean): void => {
      citeActive = next;
      citeTabs.forEach((tab, i) => {
        const on = i === next;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel !== null) panel.hidden = !on;
      });
      if (focus) citeTabs[next]?.focus();
      if (citeCopy !== null) citeCopy.textContent = "複製";
    };

    citeTabs.forEach((tab, i) => tab.addEventListener("click", () => selectCite(i, false)));
    document.querySelector(".cite-tabs")?.addEventListener("keydown", (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      const keys: Record<string, number> = {
        ArrowRight: citeActive + 1,
        ArrowLeft: citeActive - 1,
        Home: 0,
        End: citeTabs.length - 1,
      };
      if (!(event.key in keys)) return;
      event.preventDefault();
      selectCite((keys[event.key] + citeTabs.length) % citeTabs.length, true);
    });
    citeCopy?.addEventListener("click", async () => {
      const panel = document.getElementById(citeTabs[citeActive]?.getAttribute("aria-controls") ?? "");
      try {
        await navigator.clipboard.writeText(panel?.textContent?.trim() ?? "");
        citeCopy.textContent = "已複製";
        announce("已複製引用");
      } catch {
        citeCopy.textContent = "複製唔到";
      }
    });

    /* ---- ?hl= 檢索高亮 ---- */

    const params = new URLSearchParams(window.location.search);
    const hl = params.get("hl")?.trim() ?? "";
    const hlChip = document.getElementById("hl-chip");

    if (hl !== "" && body !== null && hlChip !== null) {
      const marks: HTMLElement[] = [];
      for (const unit of body.querySelectorAll(".art-title, .art-flow")) {
        const nodes = textNodes(unit, "rt, .tr");
        const ranges = highlightRanges(nodes.map((node) => node.data).join(""), hl);
        marks.push(
          ...wrapRanges(nodes, ranges, () => {
            const mark = document.createElement("mark");
            mark.className = "hl";
            return mark;
          }),
        );
      }
      hlChip.textContent = `標示「${hl}」 ✕`;
      hlChip.setAttribute("aria-label", `清除標示「${hl}」`);
      hlChip.hidden = false;
      marks[0]?.scrollIntoView({ block: "center", inline: "center" });

      hlChip.addEventListener("click", () => {
        for (const mark of document.querySelectorAll("mark.hl")) {
          const parent = mark.parentNode;
          mark.replaceWith(...mark.childNodes);
          parent?.normalize();
        }
        hlChip.hidden = true;
        // 掣收埋咗：焦點交畀隔籬嘅行款掣，唔好跌返去頁頂。
        document.querySelector<HTMLButtonElement>("#rd-toolbar [data-layout]")?.focus();
        announce("已清除標示");
        params.delete("hl");
        const query = params.toString();
        window.history.replaceState(
          window.history.state,
          "",
          `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`,
        );
      });
    }

    /* ---- 已回報標記（本機記錄 + /api/reports） ---- */

    interface Span {
      start: number;
      end: number;
    }

    interface StoredReport {
      id?: number | null;
      article_id?: string;
      selected_text?: string;
      span_start?: unknown;
      span_end?: unknown;
      type?: string;
      created_at?: string;
    }

    const STORE_KEY = "jm-reports";
    const marked = new Set<string>();

    const readStore = (): StoredReport[] => {
      try {
        const parsed: unknown = JSON.parse(window.localStorage.getItem(STORE_KEY) ?? "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    const writeStore = (entries: StoredReport[]): void => {
      try {
        window.localStorage.setItem(STORE_KEY, JSON.stringify(entries.slice(-200)));
      } catch {
        /* 本機儲存唔可用時只保留今次標記 */
      }
    };

    const spanOf = (entry: StoredReport): Span | null =>
      typeof entry.span_start === "number" && typeof entry.span_end === "number" && entry.span_end > entry.span_start
        ? { start: entry.span_start, end: entry.span_end }
        : null;

    /**
     * 標返已回報嘅字，逐個文字節點包 .reported（琥珀淡底、虛線）。
     * 有正文碼點區間就照區間標（同 capture() 一樣逐片換算）；舊上報冇區間先搵字（唔計空白）。
     */
    const markReported = (articleId: string, text: string, type: string, span: Span | null): void => {
      const key = `${articleId}\u0000${span === null ? text : `${span.start}:${span.end}`}`;
      const flow = document.getElementById(articleId)?.querySelector(".art-flow");
      if ((span === null && text === "") || marked.has(key) || flow == null) return;
      let nodes: Text[] = [];
      let ranges: [number, number][] = [];
      if (span !== null) {
        let base = 0;
        for (const segment of flow.querySelectorAll<HTMLElement>(".para [data-o]")) {
          let offset = Number(segment.dataset.o);
          for (const node of textNodes(segment, "rt")) {
            const chars = [...node.data];
            const from = Math.max(span.start - offset, 0);
            const to = Math.min(span.end - offset, chars.length);
            if (from < to) {
              const head = chars.slice(0, from).join("").length;
              ranges.push([base + head, base + head + chars.slice(from, to).join("").length]);
              nodes.push(node);
              base += node.data.length;
            }
            offset += chars.length;
          }
        }
      } else {
        nodes = textNodes(flow, "rt, .tr");
        ranges = highlightRanges(nodes.map((node) => node.data).join(""), text).slice(0, 1);
      }
      if (ranges.length === 0) return;
      marked.add(key);
      wrapRanges(nodes, ranges, () => {
        const element = document.createElement("span");
        element.className = "reported";
        element.title = `已回報（${type}）· 待審`;
        return element;
      });
    };

    const markAll = (entries: StoredReport[]): void => {
      for (const entry of entries) {
        if (typeof entry?.article_id === "string" && typeof entry?.selected_text === "string") {
          markReported(entry.article_id, entry.selected_text, entry.type ?? "已回報", spanOf(entry));
        }
      }
    };

    const restoreReports = async (): Promise<void> => {
      markAll(readStore());
      for (const article of document.querySelectorAll<HTMLElement>("[data-article]")) {
        try {
          const response = await fetch(`/api/reports?article_id=${encodeURIComponent(article.id)}`);
          if (!response.ok) continue;
          const result: unknown = await response.json();
          const reports =
            typeof result === "object" && result !== null && Array.isArray((result as { reports?: unknown }).reports)
              ? ((result as { reports: Record<string, unknown>[] }).reports)
              : [];
          markAll(
            reports.map((report) => ({
              article_id: article.id,
              selected_text: typeof report.selected_text === "string" ? report.selected_text : "",
              span_start: report.span_start,
              span_end: report.span_end,
              type: typeof report.type === "string" ? report.type : "已回報",
            })),
          );
        } catch {
          /* 服務未通時只靠本機記錄 */
        }
      }
    };

    void restoreReports();

    /* ---- 揀字報錯 ---- */

    interface Picked {
      text: string;
      fragment: string;
      articleId: string;
      paragraphIndex: number;
      span: Span | null;
    }

    const form = document.getElementById("rp-form");
    const hint = document.getElementById("rp-hint");
    const selBox = document.getElementById("rp-sel");
    const submit = document.getElementById("rp-submit");
    const errorBox = document.getElementById("rp-error");
    const done = document.getElementById("rp-done");
    let picked: Picked | null = null;
    let sending = false;

    /** 由選區推出上報資料：篇 id、段序、正文碼點區間、前後文（前後各 20 字）。 */
    const capture = (): Picked | null => {
      const selection = window.getSelection();
      if (body === null || selection === null || selection.rangeCount === 0 || selection.isCollapsed) return null;
      const range = selection.getRangeAt(0);
      const start = elementOf(range.startContainer);
      const end = elementOf(range.endContainer);
      if (start === null || end === null || !body.contains(start) || !body.contains(end)) return null;
      if (start.closest("rt") !== null && end.closest("rt") !== null) return null;
      const article = start.closest<HTMLElement>("[data-article]");
      if (article === null || article !== end.closest("[data-article]")) return null;
      // 跨段選區會掃過段與段之間嘅今譯（豎排、關今譯時仍喺 DOM）：由今譯起揀先計譯文。
      const raw = flatText(range.cloneContents(), start.closest(".tr") === null ? "rt, .tr" : "rt");
      const text = raw.trim();
      if (text === "") return null;

      const pieces: SelectionPiece[] = [];
      for (const segment of article.querySelectorAll<HTMLElement>(".para [data-o]")) {
        if (!range.intersectsNode(segment)) continue;
        let offset = Number(segment.dataset.o);
        for (const node of textNodes(segment, "rt")) {
          if (range.intersectsNode(node)) {
            const from = node === range.startContainer ? range.startOffset : 0;
            const to = node === range.endContainer ? range.endOffset : node.data.length;
            pieces.push({ start: offset + [...node.data.slice(0, from)].length, text: node.data.slice(from, to) });
          }
          offset += [...node.data].length;
        }
      }

      // 前後文：由選區頭尾向所在段量出去，唔靠搜尋（重複字唔會走位）。
      const hosts = ".para, .tr p, .art-title";
      const startHost = start.closest(hosts);
      const endHost = end.closest(hosts) ?? startHost;
      let before = "";
      let after = "";
      if (startHost !== null && endHost !== null) {
        const pre = document.createRange();
        pre.setStart(startHost, 0);
        pre.setEnd(range.startContainer, range.startOffset);
        const post = document.createRange();
        post.setStart(range.endContainer, range.endOffset);
        post.setEnd(endHost, endHost.childNodes.length);
        before = flatText(pre.cloneContents());
        after = flatText(post.cloneContents());
      }
      return {
        text,
        fragment: fragmentAround(before, raw, after).replace(/\s+/gu, " ").trim(),
        articleId: article.id,
        paragraphIndex: Number(start.closest<HTMLElement>("[data-pi]")?.dataset.pi ?? 0),
        span: selectionSpan(pieces),
      };
    };

    const checkedType = (): string =>
      form?.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value ?? "";

    const render = (): void => {
      if (hint !== null) {
        hint.textContent = picked
          ? "所選文字（喺正文再揀可以更換）："
          : "喺正文揀選有問題嘅字，就會自動帶入呢度。";
      }
      if (selBox !== null) {
        const shown = picked ? clipText(picked.text, 40) : "";
        selBox.textContent = picked ? `「${shown}${shown.length < picked.text.length ? "…" : ""}」` : "";
        selBox.hidden = picked === null;
      }
      if (submit instanceof HTMLButtonElement) {
        const ready = picked !== null && checkedType() !== "";
        submit.disabled = !ready || sending;
        submit.textContent = sending ? "提交緊…" : ready ? "提交上報" : "揀選正文同問題類型先可以提交";
      }
    };

    const onSelection = (): void => {
      const next = capture();
      if (next === null) return;
      if (picked?.text === next.text && picked.articleId === next.articleId && picked.span?.start === next.span?.start) {
        return;
      }
      picked = next;
      if (errorBox !== null) errorBox.hidden = true;
      if (form !== null && done !== null && !done.hidden) {
        done.hidden = true;
        form.hidden = false;
      }
      render();
    };

    let selectionTimer = 0;
    document.addEventListener("selectionchange", () => {
      window.clearTimeout(selectionTimer);
      selectionTimer = window.setTimeout(onSelection, 250);
    });
    document.addEventListener("mouseup", (event) => {
      if (body !== null && event.target instanceof Node && body.contains(event.target)) onSelection();
    });

    form?.addEventListener("change", render);
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const type = checkedType();
      if (!(form instanceof HTMLFormElement) || picked === null || type === "" || sending) return;
      const data = new FormData(form);
      const report = picked;
      const payload = {
        article_id: report.articleId,
        fragment: clipText(report.fragment, 600),
        selected_text: clipText(report.text, 200),
        paragraph_index: report.paragraphIndex,
        span_start: report.span?.start ?? null,
        span_end: report.span?.end ?? null,
        type,
        suggestion: String(data.get("suggestion") ?? "").trim(),
        website: String(data.get("website") ?? ""),
      };
      sending = true;
      if (errorBox !== null) errorBox.hidden = true;
      render();
      // 只顯示服務端講嘅原因（例如限流）；網絡錯誤一律用通用文案。
      let failure = "送出失敗，請稍後再試。";
      try {
        const response = await fetch("/api/correct", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result: { ok?: unknown; id?: unknown; error?: unknown } = await response.json().catch(() => ({}));
        if (!response.ok || result.ok !== true) {
          if (typeof result.error === "string" && result.error !== "") failure = result.error;
          throw new Error(failure);
        }
        const entries = readStore().filter(
          (entry) =>
            !(
              entry.article_id === payload.article_id &&
              entry.selected_text === payload.selected_text &&
              entry.span_start === payload.span_start
            ),
        );
        entries.push({
          id: typeof result.id === "number" ? result.id : null,
          article_id: payload.article_id,
          selected_text: payload.selected_text,
          span_start: payload.span_start,
          span_end: payload.span_end,
          type,
          created_at: new Date().toISOString(),
        });
        writeStore(entries);
        markReported(payload.article_id, payload.selected_text, type, report.span);
        // 清返類型同建議：之後再揀字唔會帶住上一單嘅內容。
        form.reset();
        form.hidden = true;
        if (done !== null) {
          done.hidden = false;
          done.querySelector<HTMLElement>(".rp-ok")?.focus();
        }
      } catch {
        if (errorBox !== null) {
          errorBox.textContent = failure;
          errorBox.hidden = false;
        }
      } finally {
        sending = false;
        render();
        // 送出期間提交掣停用咗會甩焦點；失敗時交返畀佢（錯誤由 role=alert 讀出）。
        if (!form.hidden) submit?.focus();
      }
    });

    document.getElementById("rp-again")?.addEventListener("click", () => {
      picked = null;
      if (form instanceof HTMLFormElement) {
        form.reset();
        form.hidden = false;
      }
      if (done !== null) done.hidden = true;
      window.getSelection()?.removeAllRanges();
      render();
      hint?.focus();
    });

    /* ---- 辭叢查詞：撳正文一個字，300ms 後浮出詞卡（觸控機唔出） ---- */

    const dictCard = document.getElementById("dict-card");
    const dictWord = document.getElementById("dict-word");
    const dictLink = document.getElementById("dict-link");
    let dictTimer = 0;
    let dictPoint: { x: number; y: number } | null = null;

    const hideDict = (): void => {
      window.clearTimeout(dictTimer);
      dictPoint = null;
      if (dictCard !== null) dictCard.hidden = true;
    };

    const wordAtPoint = (x: number, y: number): { word: string; rect: DOMRect } | null => {
      const caretDocument = document as unknown as {
        caretRangeFromPoint?: (x: number, y: number) => Range | null;
        caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null;
      };
      let node: Node | null = null;
      let offset = 0;
      let rect: DOMRect | null = null;
      const range = caretDocument.caretRangeFromPoint?.(x, y) ?? null;
      if (range !== null) {
        node = range.startContainer;
        offset = range.startOffset;
        rect = range.getBoundingClientRect();
      } else {
        const position = caretDocument.caretPositionFromPoint?.(x, y) ?? null;
        if (position !== null) {
          node = position.offsetNode;
          offset = position.offset;
        }
      }
      if (node === null || node.nodeType !== Node.TEXT_NODE) return null;
      const parent = node.parentElement;
      const host = parent?.closest(".para, .tr p") ?? null;
      if (parent == null || host === null || parent.closest("rt") !== null) return null;
      // 注音字各自一個文字節點：成段串埋先擴得到詞；位置按碼點計。
      const nodes = textNodes(host, "rt");
      let at = [...(node.nodeValue ?? "").slice(0, offset)].length;
      for (const item of nodes) {
        if (item === node) break;
        at += [...item.data].length;
      }
      const full = nodes.map((item) => item.data).join("");
      // 撳字嘅後半邊，光標會落喺下一格：嗰格唔係詞字就退返一格。
      const word = wordAround(full, at) ?? wordAround(full, at - 1);
      if (word === null) return null;
      return { word, rect: rect ?? parent.getBoundingClientRect() };
    };

    const showDict = (word: string, rect: DOMRect): void => {
      if (dictCard === null || dictWord === null || dictLink === null) return;
      dictWord.textContent = word;
      dictLink.textContent = `去辭叢查「${word}」`;
      dictLink.setAttribute("href", `https://jyutjyu.com/word/${encodeURIComponent(word)}`);
      dictCard.hidden = false;
      const width = dictCard.offsetWidth;
      const height = dictCard.offsetHeight;
      const x = Math.max(8, Math.min(rect.left + rect.width / 2 - width / 2, window.innerWidth - width - 8));
      let y = rect.top - height - 8;
      if (y < 8) y = rect.bottom + 8;
      dictCard.style.setProperty("--x", `${Math.round(x)}px`);
      dictCard.style.setProperty("--y", `${Math.round(Math.min(y, window.innerHeight - height - 8))}px`);
    };

    document.addEventListener("mouseup", (event) => {
      if (window.matchMedia("(hover: none)").matches) return;
      if (event.target instanceof Element && event.target.closest(".dict-card") !== null) return;
      if (body === null || !(event.target instanceof Node) || !body.contains(event.target)) {
        hideDict();
        return;
      }
      const selection = window.getSelection();
      if (selection !== null && !selection.isCollapsed) {
        hideDict();
        return;
      }
      const found = wordAtPoint(event.clientX, event.clientY);
      window.clearTimeout(dictTimer);
      if (found === null) {
        hideDict();
        return;
      }
      dictPoint = { x: event.clientX, y: event.clientY };
      dictTimer = window.setTimeout(() => showDict(found.word, found.rect), 300);
    });

    document.addEventListener(
      "mousemove",
      (event) => {
        if (dictPoint === null) return;
        if (Math.abs(event.clientX - dictPoint.x) + Math.abs(event.clientY - dictPoint.y) > 10) hideDict();
      },
      true,
    );
    document.addEventListener("scroll", hideDict, true);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hideDict();
    });
  </script>
</Base>

<style>
  /* ---- 工具列：黏喺頁首下面 ---- */

  .rd-toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: rgba(248, 247, 242, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-10);
  }

  .rd-toolbar__inner {
    max-width: var(--wrap-reader);
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    color: var(--graphite);
  }

  .crumb__cur {
    font-weight: 600;
    color: var(--wood);
  }

  .rd-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /* ---- 版面：≥1080 三欄，否則單欄 ---- */

  .rd-grid {
    max-width: var(--wrap-reader);
    margin: 0 auto;
    padding: 28px var(--gutter) 96px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 28px;
  }

  .rd-toc,
  .rd-side {
    min-width: 0;
  }

  @media (min-width: 1080px) {
    .rd-grid {
      grid-template-columns: 248px minmax(0, 1fr) 300px;
    }

    .rd-toc,
    .rd-side {
      position: sticky;
      top: calc(var(--header-h) + var(--toolbar-h, 62px));
    }

    /* 只限高目錄；右欄唔限高，報錯掣靠捲頁就見到。
       左右各借 4px，期號格貼邊嘅焦點框（2px + 2px offset）唔會畀 overflow 裁走 */
    .rd-toc {
      max-height: calc(100vh - var(--header-h) - var(--toolbar-h, 62px) - 16px);
      overflow: auto;
      margin-inline: -4px;
      padding-inline: 4px;
    }

    /* 目錄自動捲到當前篇時，期號卡頭照樣黏頂 */
    .toc-head {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--page);
    }
  }

  /* 單欄：頁首換行變高，工具列唔再黏頂，免得兩層遮咗大半個螢幕 */
  @media (max-width: 1079px) {
    .rd-toolbar {
      position: static;
    }

    .art {
      scroll-margin-top: calc(var(--header-h) + 16px);
    }
  }

  /* ---- 左欄：目錄 ---- */

  .toc-head {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-10);
  }

  .toc-head p {
    margin: 0;
  }

  .toc-head .toc-title {
    margin-top: 8px;
    font-size: 21px;
    line-height: 1.3;
  }

  .toc-meta {
    font-size: 15px;
    color: var(--graphite);
  }

  .issue-switch {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

  .issue-switch a {
    padding: 6px 0;
    line-height: 1.25;
    text-align: center;
    border: 1px solid rgba(30, 21, 18, 0.15);
    background: #fff;
    color: var(--wood);
    transition:
      background-color 200ms,
      border-color 200ms;
  }

  .issue-switch a:hover {
    text-decoration: none;
    border-color: var(--blue);
  }

  .issue-switch a[aria-current] {
    border-color: var(--blue);
    background: var(--blue);
    color: #fff;
  }

  .issue-switch__num,
  .issue-switch__date {
    display: block;
  }

  .issue-switch__num {
    font-size: 19px;
  }

  .issue-switch__date {
    font-size: 12px;
  }

  .toc-toggle {
    display: none;
    margin-top: 12px;
    padding: 6px 12px;
    border: 1px solid var(--line-20);
    background: transparent;
    font-size: 15px;
    cursor: pointer;
    transition: background-color 200ms;
  }

  .toc-toggle:hover {
    background: var(--surface-3);
  }

  .toc-list {
    margin: 0;
    padding: 8px 0;
    list-style: none;
  }

  .toc-item {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 8px;
    padding: 7px 10px;
    border-left: 3px solid transparent;
    color: var(--wood);
    font-size: 16px;
    line-height: 1.45;
    transition: background-color 200ms;
  }

  .toc-item:hover {
    background: var(--surface-3);
    text-decoration: none;
  }

  .toc-item:focus-visible {
    outline-offset: -2px;
  }

  .toc-item.is-current {
    border-left-color: var(--blue);
    background: #f7f5ef;
    font-weight: 700;
  }

  .toc-num {
    padding-top: 1px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--graphite);
  }

  @media (max-width: 1079px) {
    .toc-toggle {
      display: inline-block;
    }

    .toc-list {
      display: none;
    }

    .rd-toc.is-open .toc-list {
      display: block;
    }
  }

  /* ---- 中欄：正文卡（6px 木框、紙面） ---- */

  .rd-card {
    min-width: 0;
    border: 6px solid var(--wood);
    background: var(--paper);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 22px clamp(20px, 3vw, 40px);
    border-bottom: 1px solid var(--line-08);
  }

  .leaf-no {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.75;
  }

  .leaf-no__num {
    font-family: var(--latin);
    font-size: 48px;
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--blue);
  }

  .leaf-no__pos {
    color: var(--graphite);
  }

  .card-body {
    padding: clamp(24px, 3vw, 44px) clamp(20px, 3vw, 44px) 8px;
  }

  .art {
    margin-bottom: 44px;
    scroll-margin-top: calc(var(--header-h) + var(--toolbar-h, 62px) + 16px);
  }

  .art-head {
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }

  /* 無題篇章：淨係錨點，貼近正文 */
  .art-head--bare {
    margin-bottom: 8px;
  }

  .art-title {
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .art-anchor {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--graphite);
  }

  .art-anchor.is-copied::after {
    content: " · 已複製連結";
    color: var(--green-text);
  }

  .art-empty {
    margin: 0;
    font-size: 17px;
    color: var(--graphite);
  }

  /* 正文：橫排 CJK 22px；英文為主 19px；豎排只畀 CJK 篇章 26px。
     豎排有粵拼：字距 0.3em、行高 2（同關粵拼一致，開關粵拼時行唔會郁）；2026-10-06 維護者要求，
     偏離 handoff 嘅 2.5／0.08em：同一行字拉開，每個字連埋粵拼自成一格，唔會睇錯隔籬行。 */
  .art-text {
    display: flex;
    justify-content: flex-end;
  }

  .art-flow {
    width: 100%;
    font-size: 22px;
    line-height: 2.35;
    letter-spacing: 0.02em;
    color: var(--wood);
  }

  .art--latin .art-flow {
    font-size: 19px;
    letter-spacing: 0;
  }

  :global(html.rd-nojp) .art-flow {
    line-height: 1.95;
  }

  :global(html.rd-nojp) .art--latin .art-flow {
    line-height: 1.8;
  }

  :global(html:not(.rd-h)) .art--cjk .art-flow {
    writing-mode: vertical-rl;
    width: auto;
    max-width: 100%;
    height: clamp(420px, 64vh, 700px);
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 6px;
    font-size: 26px;
    line-height: 2;
    letter-spacing: 0.3em;
  }

  /* 豎排冇粵拼：冇 rt 要讓位，字距收返 0.08em；行高同開粵拼一樣係 2 */
  :global(html.rd-nojp:not(.rd-h)) .art--cjk .art-flow {
    letter-spacing: 0.08em;
  }

  .para {
    margin: 0;
    margin-block-end: 0.9em;
  }

  /* 粵拼：左右留位，長讀音唔會連成一串；唔畀揀（拖揀唔會錨錯行首，複製亦唔夾拼音） */
  .art-flow :global(rt) {
    padding-inline: 0.3em;
    font-family: var(--latin);
    font-size: 0.42em;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--blue);
    -webkit-user-select: none;
    user-select: none;
  }

  /* 豎排 rt 喺字右邊：block-end 加 4px（Chrome 實測粵拼離字遠約 6px）；沿用通用 rt 嘅 padding-inline .3em，長讀音之間先唔會黐埋 */
  :global(html:not(.rd-h)) .art--cjk .art-flow :global(rt) {
    padding-block-end: 4px;
  }

  :global(html.rd-nojp) .art-flow :global(rt) {
    display: none;
  }

  /* □ 缺字；已回報字（琥珀淡底、虛線）。text-decoration 喺豎排會自動轉去字側 */
  .art-flow :global(.miss) {
    color: var(--blue);
    text-decoration: underline dashed var(--blue);
    text-underline-offset: 0.2em;
    cursor: help;
  }

  .card-body :global(.reported) {
    background: var(--amber-a12);
    color: var(--amber-text);
    text-decoration: underline dashed var(--amber-text);
    text-underline-offset: 0.25em;
    cursor: help;
  }

  /* ---- 今譯：橫排逐段、豎排成篇 callout；關今譯時全部收起 ---- */

  .tr {
    padding: 20px 24px;
    background: var(--tr-bg);
    border-left: 4px solid var(--green);
    font-size: 18px;
    line-height: 1.9;
    letter-spacing: 0;
    color: var(--wood);
  }

  .tr-whole {
    margin-top: 28px;
  }

  .tr-inline {
    margin: -0.2em 0 1.4em;
    padding: 14px 20px;
  }

  .tr-inline,
  .tr-whole {
    display: none;
  }

  :global(html:not(.rd-notr)) .tr-inline {
    display: block;
  }

  :global(html:not(.rd-notr):not(.rd-h)) .art--cjk .tr-inline {
    display: none;
  }

  :global(html:not(.rd-notr):not(.rd-h)) .art--cjk .tr-whole {
    display: block;
  }

  .tr-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
    line-height: 1.75;
  }

  .tr-tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-text);
  }

  .tr-ver {
    font-size: 14px;
    color: var(--graphite);
  }

  .tr p {
    margin: 0 0 0.8em;
    text-wrap: pretty;
  }

  .tr-inline p {
    margin: 0;
  }

  .tr :global(.tr-note) {
    font-size: 15px;
    color: var(--amber-text);
  }

  /* ---- 插圖等版面標記 ---- */

  .ph {
    margin-bottom: 44px;
    min-height: 180px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    background: var(--surface-3);
    border: 1.5px dashed rgba(30, 21, 18, 0.22);
  }

  .ph__text {
    font-size: 22px;
  }

  .ph__note {
    font-size: 15px;
    color: var(--graphite);
  }

  /* ---- 卡底：揭頁 ---- */

  .card-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px clamp(20px, 3vw, 40px);
    border-top: 1px solid var(--line-08);
    background: var(--surface-2);
  }

  .pg {
    padding: 10px 18px;
    white-space: nowrap;
  }

  .pg--prev {
    justify-self: start;
  }

  /* 原型下一頁 border:0 + 10px 18px；.btn 有 1px 透明邊，所以 padding 減 1px（比上一頁矮 2px，同原型） */
  .pg--next {
    justify-self: end;
    padding: 9px 17px;
  }

  /* 期尾：同上一頁一樣淡到 .35，唔用報錯掣嗰種半透明底 */
  .pg--next[aria-disabled="true"] {
    background: var(--blue);
    opacity: 0.35;
  }

  .pg-pos {
    white-space: nowrap;
  }

  .pg-info {
    margin: 0;
    font-size: 15px;
    text-align: center;
    color: var(--graphite);
  }

  .pg-info b {
    color: var(--wood);
  }

  .pg-hint {
    font-size: 13px;
  }

  /* 窄螢幕：中間說明擺上面成行，兩粒掣喺下面左右分開，唔使逼到一字一行 */
  @media (max-width: 519px) {
    .card-foot {
      grid-template-columns: 1fr 1fr;
    }

    .pg-info {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  /* ---- 右欄：三張中性燈籠框（來源、引用、報錯） ---- */

  .rd-side {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .src-pane {
    padding: 22px 24px;
  }

  .src-pane h2 {
    margin: 0 0 14px;
    font-size: 22px;
  }

  .src-list {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 9px 16px;
    font-size: 16px;
    line-height: 1.5;
  }

  .src-list dt {
    color: var(--graphite);
  }

  .src-list dd {
    margin: 0;
  }

  .cite-pane {
    padding: 6px 4px 4px;
  }

  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px 0;
  }

  .cite-head h2,
  .rp-pane h2 {
    font-size: 20px;
  }

  .cite-copy {
    border-color: var(--blue-a35);
  }

  .cite-copy:hover {
    background: var(--blue-a08);
  }

  .cite-tabs {
    display: flex;
    padding: 6px 18px 0;
    border-bottom: 1px solid var(--line-10);
  }

  .cite-tabs [role="tab"] {
    margin-bottom: -1px;
    padding: 8px 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--graphite);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 200ms,
      border-color 200ms;
  }

  .cite-tabs [role="tab"][aria-selected="true"] {
    border-bottom-color: var(--blue);
    color: var(--blue);
  }

  .cite-pre {
    margin: 0;
    padding: 12px 14px;
    max-height: 220px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-all;
    font-size: 13px;
    line-height: 1.6;
    color: var(--wood);
  }

  .cite-pre:focus-visible {
    outline-offset: -2px;
  }

  .rp-pane h2 {
    margin: 0 0 8px;
  }

  .rp-form p {
    margin: 0;
  }

  .rp-hint {
    font-size: 15px;
    color: var(--graphite);
  }

  .rp-form .rp-sel {
    margin-top: 8px;
    padding: 8px 12px;
    background: var(--gold-tint);
    color: var(--blue);
    font-size: 18px;
    line-height: 1.5;
    word-break: break-all;
  }

  .rp-types {
    min-width: 0;
    margin: 14px 0 0;
    padding: 0;
    border: 0;
  }

  .rp-types legend {
    float: left;
    width: 100%;
    margin: 0 0 8px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
  }

  .rp-chips {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .rp-chip {
    position: relative;
  }

  /* 問題類型：方角細 chip，選中寶藍底白字 */
  .rp-type {
    display: inline-block;
    padding: 3px 12px;
    border: 1px solid var(--line-18);
    font-size: 15px;
    cursor: pointer;
    transition:
      background-color 200ms,
      border-color 200ms,
      color 200ms;
  }

  .rp-type:hover {
    background: var(--surface-3);
  }

  .rp-chip input:checked + .rp-type {
    border-color: var(--blue);
    background: var(--blue);
    color: #fff;
  }

  .rp-chip input:focus-visible + .rp-type {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .rp-note {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line-18);
    background: var(--surface-2);
    font-size: 16px;
    resize: vertical;
  }

  .rp-note:focus {
    border-color: var(--blue);
  }

  .rp-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* 實色掣有 1px 透明邊：上下 9px 等於原型 10px＋0 邊；文案置中，左右收窄免得 300px 欄斷行。
     原型 textarea 係 inline-block，行框下面多約 9px，所以 margin-top 19px */
  .rp-submit {
    width: 100%;
    margin-top: 19px;
    padding: 9px 4px;
    font-size: 16px;
    font-weight: 700;
  }

  .rp-form .rp-error {
    margin-top: 8px;
    font-size: 14px;
    color: var(--ruby);
  }

  .rp-form .rp-foot {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--graphite);
  }

  .rp-ok {
    margin: 0;
    padding: 14px 16px;
    background: var(--green-a12);
    color: var(--green-text);
    font-size: 16px;
    line-height: 1.6;
  }

  /* 原型 6px 12px＋1px 邊；中性掣本身有 1px 邊，照搬 */
  .rp-again {
    margin-top: 10px;
    padding: 6px 12px;
    font-weight: 400;
  }

  /* ---- 辭叢詞卡（位置由 --x / --y 設定）：方角、冇陰影；同正文同係紙色，靠 2px 木色框分開 ---- */

  .dict-card {
    position: fixed;
    left: var(--x, 0px);
    top: var(--y, 0px);
    z-index: 65;
    max-width: min(280px, calc(100vw - 16px));
    padding: 12px 14px;
    background: var(--paper);
    border: 2px solid var(--wood);
  }

  .dict-card__word {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }

  .dict-card__link {
    font-size: 15px;
  }

  .dict-card__hint {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--graphite);
  }
</style>
