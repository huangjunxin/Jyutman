---
/**
 * 檢索頁：青磚牆上一個大號燈籠框（眉標、H1、檢索框、三欄提示），下面客戶端查 /api/search
 * （KWIC 列、語料篩選 pill、逐頁追加）。靜態頁，q / corpus 由客戶端讀 URL；
 * 後端只支援漢字同英文全文檢索，冇粵拼檢索；歸一只做同一個字嘅簡繁轉換。
 */
import Eyebrow from "../../components/Eyebrow.astro";
import Glass from "../../components/Glass.astro";
import SearchBar from "../../components/SearchBar.astro";
import Base from "../../layouts/Base.astro";
import { corpusMeta } from "../../utils/corpus-meta.ts";
import { getCorpora } from "../../utils/corpus.ts";
import { searchHref } from "../../utils/search-view.ts";

const corpora = getCorpora().map((corpus, index) => ({
  slug: corpus.slug,
  shortTitle: corpusMeta(corpus, index).shortTitle,
  issueCount: corpus.issueCount,
  year: corpus.year,
}));
const hints = [
  {
    tone: "blue",
    title: "漢字",
    text: "直接輸入字詞，按底本原字配對。",
    chips: ["廣東", "唔係"],
  },
  {
    tone: "amber",
    title: "簡體",
    text: "常用簡體字會自動轉做底本嘅繁體字，例如「广东」都搵到「廣東」。",
    chips: ["广东"],
    simp: true,
  },
  {
    tone: "green",
    title: "English",
    text: "兩本英文課本嘅講解可以全文檢索。",
    chips: ["tone"],
  },
];
---

<Base
  title="檢索 · 粵語文叢"
  description="粵語文叢全文檢索：常用簡體字歸一到繁體之後，逐葉命中底本原文，並顯示命中上下文。"
  current="search"
  noindex
>
  <section class="brick top">
    <div class="wrap top__inner">
      <Glass class="window" paneClass="window__pane">
        <Eyebrow text="Search · 檢索" />
        <h1 class="title">檢索</h1>
        <SearchBar variant="band" inputId="search-q" />
        <div class="hints">
          {
            hints.map((hint) => (
              <div class="hint">
                <h2 class="hint__title">
                  <span class={`hint__glass tone-${hint.tone}`} aria-hidden="true" />
                  {hint.title}
                </h2>
                <p class="hint__text">{hint.text}</p>
                <ul class="hint__chips" aria-label={`${hint.title}示例`}>
                  {hint.chips.map((word) => (
                    <li>
                      <a class="chip chip--sm" href={searchHref(word)}>
                        {word}
                        {hint.simp && <span class="chip__simp">簡</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="footnote">歸一只發生喺檢索層，展示永遠保留原字。</p>
      </Glass>
    </div>
  </section>

  <section class="wrap results" id="search-root" data-corpora={JSON.stringify(corpora)}>
    <p class="visually-hidden" role="status" id="search-live"></p>

    <div id="search-results" hidden>
      <div class="res-head">
        <div>
          <h2 class="res-head__q" id="search-heading"></h2>
          <p class="res-head__meta">共 <b id="search-total"></b> 篇 · <span id="search-mode"></span></p>
        </div>
        <div class="pills" role="group" aria-label="按語料篩選" id="search-pills"></div>
      </div>
      <p class="notice" id="search-notice" hidden></p>
      <ol class="kwic" id="search-list"></ol>
      <div class="empty" id="search-empty" hidden>
        <p class="empty__title" id="search-empty-title"></p>
        <p class="empty__hint">試下用簡體字，或者短啲嘅詞。</p>
      </div>
      <div class="more" id="search-more-wrap" hidden>
        <button type="button" class="btn btn--outline more__btn" id="search-more"></button>
      </div>
    </div>

    <p class="loading" id="search-loading" aria-hidden="true" hidden>載入緊…</p>
    <script is:inline>
      // 有 q 就喺首次繪畫前顯示載入緊，免得閃一下。
      if ((new URLSearchParams(location.search).get("q") ?? "").trim()) {
        document.getElementById("search-loading").hidden = false;
      }
    </script>
    <p class="error" id="search-error" hidden></p>
  </section>
</Base>

<script>
  import { pageParam, statusBadge } from "../../utils/reader.ts";
  import {
    facetPills,
    hitHref,
    hitIssueLabel,
    normalizationNotice,
    searchHref,
    searchModeLabel,
  } from "../../utils/search-view.ts";

  interface CorpusInfo {
    slug: string;
    shortTitle: string;
    issueCount: number;
    year: number | null;
  }

  interface SearchHit {
    id: string;
    corpus: string;
    issue: string;
    page: number;
    title: string | null;
    status?: string;
    pre: string;
    highlight: string | null;
    post: string | null;
  }

  interface SearchPayload {
    normalized?: string;
    total?: number;
    facets?: Record<string, number>;
    results?: SearchHit[];
    more?: boolean;
    error?: string;
  }

  const PAGE_SIZE = 40;
  const FALLBACK_ERROR = "檢索服務暫時未能使用，請稍後再試。";

  const byId = (id: string): HTMLElement => document.getElementById(id) as HTMLElement;
  const root = byId("search-root");
  const corpora = JSON.parse(root.dataset.corpora ?? "[]") as CorpusInfo[];
  const corpusBySlug = new Map(corpora.map((corpus) => [corpus.slug, corpus]));

  const live = byId("search-live");
  const results = byId("search-results");
  const heading = byId("search-heading");
  const totalNode = byId("search-total");
  const modeNode = byId("search-mode");
  const pills = byId("search-pills");
  const notice = byId("search-notice");
  const list = byId("search-list");
  const empty = byId("search-empty");
  const emptyTitle = byId("search-empty-title");
  const moreWrap = byId("search-more-wrap");
  const more = byId("search-more") as HTMLButtonElement;
  const loading = byId("search-loading");
  const error = byId("search-error");
  const inputs = ["search-q", "site-q"]
    .map((id) => document.getElementById(id))
    .filter((node): node is HTMLInputElement => node instanceof HTMLInputElement);

  let state = { q: "", corpus: null as string | null, page: 0, shown: 0, total: 0 };
  /** 每次新檢索加一；舊請求返嚟時對唔上就丟棄，避免快速切換時結果錯位。 */
  let ticket = 0;

  const el = (tag: string, className = "", text?: string): HTMLElement => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  async function fetchPage(q: string, corpus: string | null, page: number): Promise<SearchPayload> {
    const url = new URL("/api/search", window.location.origin);
    url.searchParams.set("q", q);
    url.searchParams.set("page", String(page));
    url.searchParams.set("page_size", String(PAGE_SIZE));
    if (corpus) url.searchParams.set("corpus", corpus);
    let response: Response;
    try {
      response = await fetch(url, { headers: { accept: "application/json" } });
    } catch {
      throw new Error(FALLBACK_ERROR);
    }
    const payload = (await response.json().catch(() => ({}))) as SearchPayload;
    if (!response.ok || !Array.isArray(payload.results)) throw new Error(payload.error || FALLBACK_ERROR);
    return payload;
  }

  /** 一條 KWIC 列：左上下文（左邊裁走）、命中字、右上下文（省略號），下面資料行。 */
  function hitRow(hit: SearchHit, q: string): HTMLLIElement {
    const item = document.createElement("li");
    const link = el("a", "hit") as HTMLAnchorElement;
    link.href = hitHref(hit, q);
    let line: HTMLElement;
    if (hit.highlight) {
      const pre = el("span", "hit__pre");
      pre.append(el("span", "", hit.pre));
      line = el("span", "hit__line");
      line.append(pre, el("mark", "hit__kw", hit.highlight), el("span", "hit__post", hit.post ?? ""));
    } else {
      line = el("span", "hit__line hit__line--plain", hit.pre);
    }
    const badge = statusBadge(hit.status ?? "");
    const dot = el("span", badge.tone === "ok" ? "status-dot status-dot--ok" : "status-dot");
    dot.setAttribute("aria-hidden", "true");
    const corpus = corpusBySlug.get(hit.corpus);
    const meta = el("span", "hit__meta");
    meta.append(
      dot,
      el("span", "visually-hidden", badge.label),
      el("span", "hit__corpus", corpus?.shortTitle ?? hit.corpus),
      el("span", "", hitIssueLabel(corpus, hit.issue)),
      el("span", "", `第 ${pageParam(hit.page)} 葉`),
      el("span", "", hit.title || "（無題）"),
    );
    link.append(line, meta);
    item.append(link);
    return item;
  }

  function renderHead(payload: SearchPayload): void {
    const { q, corpus } = state;
    heading.textContent = `「${q}」`;
    totalNode.textContent = String(state.total);
    modeNode.textContent = searchModeLabel(q);
    const focused = document.activeElement;
    const focusedSlug = focused instanceof HTMLElement && pills.contains(focused) ? focused.dataset.slug : undefined;
    pills.replaceChildren(
      ...facetPills(corpora, payload.facets ?? {}, corpus).map((pill) => {
        const button = el("button", "chip chip--outline", `${pill.label} · ${pill.count}`);
        button.setAttribute("type", "button");
        button.setAttribute("aria-pressed", String(pill.slug === corpus));
        button.dataset.slug = pill.slug ?? "";
        button.addEventListener("click", () => {
          if (pill.slug === state.corpus) return;
          window.history.replaceState(null, "", searchHref(q, pill.slug));
          void run(q, pill.slug, true);
        });
        return button;
      }),
    );
    if (focusedSlug !== undefined) {
      pills.querySelector<HTMLButtonElement>(`button[data-slug="${CSS.escape(focusedSlug)}"]`)?.focus();
    }
    const message = normalizationNotice(q, payload.normalized ?? "");
    notice.hidden = message === null;
    notice.textContent = message ?? "";
  }

  /** 攞下一頁；fresh 即新檢索（重畫頁頭），否則追加。 */
  async function loadNext(mine: number, fresh: boolean): Promise<void> {
    // 唔用 disabled：Chrome 會將焦點由已停用嘅按鈕甩走
    more.setAttribute("aria-disabled", "true");
    error.hidden = true;
    try {
      const payload = await fetchPage(state.q, state.corpus, state.page + 1);
      if (mine !== ticket) return;
      const hits = payload.results ?? [];
      state.page += 1;
      state.total = payload.total ?? 0;
      state.shown += hits.length;
      if (fresh) renderHead(payload);
      const hadFocus = document.activeElement === more;
      const rows = hits.map((hit) => hitRow(hit, state.q));
      list.append(...rows);
      results.hidden = false;
      empty.hidden = state.total > 0;
      emptyTitle.textContent = `搵唔到「${state.q}」`;
      moreWrap.hidden = payload.more !== true;
      more.textContent = `載入多 ${PAGE_SIZE} 條（已顯示 ${state.shown} / ${state.total}）`;
      if (hadFocus && moreWrap.hidden) rows[0]?.querySelector("a")?.focus();
      if (fresh) live.textContent = state.total > 0 ? `「${state.q}」共 ${state.total} 篇` : `搵唔到「${state.q}」`;
      else live.textContent = `已顯示 ${state.shown} / ${state.total}`;
    } catch (failure) {
      if (mine !== ticket) return;
      error.textContent = failure instanceof Error ? failure.message : FALLBACK_ERROR;
      error.hidden = false;
      live.textContent = error.textContent;
    } finally {
      if (mine === ticket) {
        loading.hidden = true;
        more.removeAttribute("aria-disabled");
      }
    }
  }

  /** 由第一頁重新檢索；keepHead 即同一個查詢字換篩選，保留頁頭免得跳。 */
  async function run(q: string, corpus: string | null, keepHead: boolean): Promise<void> {
    const mine = ++ticket;
    state = { q, corpus, page: 0, shown: 0, total: 0 };
    for (const input of inputs) input.value = q;
    for (const pill of pills.querySelectorAll("button")) {
      pill.setAttribute("aria-pressed", String((pill.dataset.slug || null) === corpus));
    }
    list.replaceChildren();
    empty.hidden = true;
    moreWrap.hidden = true;
    error.hidden = true;
    results.hidden = !keepHead || q === "";
    loading.hidden = q === "";
    live.textContent = q === "" ? "" : "載入緊…";
    if (q !== "") await loadNext(mine, true);
  }

  const fromLocation = (): void => {
    const params = new URLSearchParams(window.location.search);
    void run((params.get("q") ?? "").trim(), params.get("corpus") || null, false);
  };

  more.addEventListener("click", () => {
    if (more.getAttribute("aria-disabled") === "true") return;
    loading.hidden = false;
    void loadNext(ticket, false);
  });

  for (const form of document.querySelectorAll<HTMLFormElement>('form[role="search"]')) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const q = String(new FormData(form).get("q") ?? "").trim();
      const href = searchHref(q);
      if (`${window.location.pathname}${window.location.search}` !== href) window.history.pushState(null, "", href);
      void run(q, null, false);
    });
  }

  window.addEventListener("popstate", fromLocation);
  fromLocation();
</script>

<style>
  /* 青磚牆頂部：一個大號燈籠框（寶藍帶、金黃角珠、獨立木框，最闊 880px） */
  .top {
    color: var(--wood);
  }

  .top__inner {
    padding-top: clamp(28px, 2.8vw, 36px);
    padding-bottom: clamp(40px, 5vw, 56px);
  }

  .window {
    max-width: 880px;
  }

  .window__pane {
    padding: clamp(24px, 3vw, 34px);
  }

  .title {
    margin: 12px 0 22px;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.15;
  }

  /* 三欄提示 */
  .hints {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px 28px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line-14);
  }

  .hint {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hint__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
  }

  .hint__glass {
    flex: none;
    width: 12px;
    height: 12px;
    background: var(--tone);
    outline: 2px solid var(--wood);
  }

  .hint__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--graphite);
  }

  .hint__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* li 用 flex，免得 inline-flex chip 喺行框入面多出 1px */
  .hint__chips > li {
    display: flex;
  }

  .footnote {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--graphite);
  }

  /* 結果區 */
  .results {
    padding-top: 32px;
    padding-bottom: 96px;
  }

  .res-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--wood);
  }

  .res-head > div:first-child {
    min-width: 0;
  }

  .res-head__q,
  .empty__title,
  .notice {
    overflow-wrap: anywhere;
  }

  .res-head__q {
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: 400;
    line-height: 1.2;
  }

  .res-head__meta {
    margin: 6px 0 0;
    font-size: 17px;
    color: var(--graphite);
  }

  .res-head__meta b {
    color: var(--blue);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .notice {
    margin: 16px 0 0;
    padding: 12px 16px;
    background: var(--amber-a10);
    color: var(--amber-text);
    font-size: 16px;
  }

  .kwic {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  /* KWIC 列由腳本生成，唔帶 scoped 屬性，故用 :global */
  .kwic :global(.hit) {
    display: block;
    padding: 16px 8px;
    border-bottom: 1px solid var(--line-08);
    color: var(--wood);
    transition: background-color 200ms;
  }

  .kwic :global(.hit:hover) {
    background: var(--surface);
    text-decoration: none;
  }

  .kwic :global(.hit__line) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: baseline;
    gap: 2px;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.6;
    color: var(--graphite);
  }

  .kwic :global(.hit__line--plain) {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: center;
  }

  .kwic :global(.hit__pre) {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
    white-space: nowrap;
  }

  .kwic :global(.hit__pre > span) {
    flex: none;
  }

  /* 命中字：寶藍底白字（照原型；README 寫金黃淺底，但像素參照以原型為準） */
  .kwic :global(.hit__kw) {
    padding: 0 6px;
    background: var(--blue);
    color: #fff;
  }

  .kwic :global(.hit__post) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .kwic :global(.hit__meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    margin-top: 6px;
    font-size: 14px;
    color: var(--graphite);
  }

  .kwic :global(.hit__corpus) {
    font-weight: 600;
    color: var(--wood);
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .more__btn {
    padding: 10px 22px;
  }

  .more__btn:not([aria-disabled="true"]) {
    border-color: var(--blue-a35);
  }

  .more__btn:not([aria-disabled="true"]):hover {
    background: var(--blue-a08);
    border-color: var(--blue);
  }

  .empty {
    padding: 56px 0;
    text-align: center;
  }

  .empty__title {
    margin: 0;
    font-size: 24px;
  }

  .empty__hint {
    margin: 8px 0 0;
    color: var(--graphite);
  }

  .loading {
    margin: 0;
    padding: 64px 0;
    text-align: center;
    font-size: 22px;
    color: var(--graphite);
  }

  .error {
    margin: 16px 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--ruby);
  }
</style>
