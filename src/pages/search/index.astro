---
import SearchBar from "../../components/SearchBar.astro";
import Yuwai from "../../components/Yuwai.astro";
import Base from "../../layouts/Base.astro";
import { getCorpora } from "../../utils/corpus.ts";

const corpora = getCorpora();
const query = Astro.url.searchParams.get("q") ?? "";
---

<Base
  title="檢索 · 粵語文叢"
  description="粵語文叢全文檢索：繁簡異體歸一之後，逐葉命中底本原文，並顯示命中上下文。"
  current="search"
  noindex
>
  <div class="wrap">
    <div class="page-head">
      <div>
        <h1>檢索</h1>
        <p>全庫或單一語料範圍 · 命中定位到葉 · 展示層保留底本原字</p>
      </div>
    </div>

    <div class="search-panel">
      <SearchBar value={query} inputId="search-input" examples={query === ""} />

      <div class="filters">
        <h2 id="filter-title">範圍</h2>
        <div class="filter-list" role="group" aria-labelledby="filter-title">
          {
            corpora.map((corpus) => (
              <label>
                <input type="checkbox" name="corpus" value={corpus.slug} />
                {corpus.title}
              </label>
            ))
          }
        </div>
        <p class="hint">勾選語料即收窄範圍；唔勾就搜全庫。</p>
      </div>
    </div>

    <div class="results" id="results" aria-live="polite">
      <p class="state">
        <b>輸入字詞開始檢索</b>
        可以搵漢字詞、專名或者傳教士拼式；命中會列出語料、期號同葉碼，並顯示上下文。
      </p>
    </div>
  </div>

  <Yuwai size="sm" />

  <script>
    interface SearchHit {
      id?: string;
      corpus?: string;
      issue?: string;
      page?: number;
      title?: string | null;
      pre?: string;
      highlight?: string | null;
      post?: string | null;
    }

    interface SearchPayload {
      results?: SearchHit[];
      total?: number;
      page?: number;
      more?: boolean;
    }

    const results = document.getElementById("results");
    const input = document.getElementById("search-input");
    if (results instanceof HTMLElement) {
      const params = new URLSearchParams(window.location.search);
      const query = params.get("q") ?? "";
      if (input instanceof HTMLInputElement && query !== "") input.value = query;

      const selectedCorpora = params.getAll("corpus");
      for (const box of document.querySelectorAll('input[name="corpus"]')) {
        if (box instanceof HTMLInputElement) box.checked = selectedCorpora.includes(box.value);
      }

      let listNode: HTMLUListElement | null = null;
      let shown = 0;
      let total = 0;
      let currentPage = 0;

      const stateNode = (title: string, body: string): HTMLElement => {
        const wrapper = document.createElement("p");
        wrapper.className = "state";
        const strong = document.createElement("b");
        strong.textContent = title;
        wrapper.append(strong, document.createTextNode(body));
        return wrapper;
      };

      /** 檢索服務未通（未部署、離線或者出錯）時先顯示呢段。 */
      const unavailable = () =>
        stateNode("檢索服務部署中", "全文索引暫時未通，可能正在部署或者維護，請稍後再試。");

      /** 命中片段：有 highlight 就用 <mark> 包住命中處，其餘照文字節點拼返。 */
      const snippetNode = (hit: SearchHit): HTMLElement | null => {
        if (hit.highlight) {
          const snippet = document.createElement("p");
          snippet.className = "hit-snippet";
          if (hit.pre) snippet.append(document.createTextNode(hit.pre));
          const mark = document.createElement("mark");
          mark.textContent = hit.highlight;
          snippet.append(mark);
          if (hit.post) snippet.append(document.createTextNode(hit.post));
          return snippet;
        }
        if (!hit.pre) return null;
        const snippet = document.createElement("p");
        snippet.className = "hit-snippet";
        snippet.textContent = hit.pre;
        return snippet;
      };

      const hitNode = (hit: SearchHit): HTMLLIElement | null => {
        if (!hit.corpus || !hit.issue || typeof hit.page !== "number") return null;
        const page = String(hit.page).padStart(3, "0");
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `/read/${hit.corpus}/${hit.issue}/${page}/${hit.id ? `#${hit.id}` : ""}`;
        link.textContent = hit.title ?? "（無題）";
        const meta = document.createElement("span");
        meta.className = "hit-meta";
        meta.textContent = `${hit.corpus} · ${hit.issue} · 第 ${page} 葉`;
        item.append(link, meta);
        const snippet = snippetNode(hit);
        if (snippet) item.append(snippet);
        return item;
      };

      const footer = document.createElement("div");
      footer.className = "hits-foot";

      const renderFooter = (): void => {
        footer.replaceChildren();
        if (shown === 0) return;
        const count = document.createElement("p");
        count.className = "hits-count";
        count.textContent = `已顯示 ${shown} / 共 ${total} 條`;
        footer.append(count);
        if (shown < total) {
          const more = document.createElement("button");
          more.type = "button";
          more.className = "btn";
          more.textContent = "載入更多";
          more.addEventListener("click", () => {
            more.disabled = true;
            void load(currentPage + 1, true).then((ok) => {
              if (!ok) {
                more.disabled = false;
                results.replaceChildren(unavailable());
              }
            });
          });
          footer.append(more);
        }
        results.append(footer);
      };

      /** 檢索 API 由 Worker 提供；離線或出錯時顯示部署提示。 */
      const load = async (page: number, append: boolean): Promise<boolean> => {
        const url = new URL("/api/search", window.location.origin);
        url.searchParams.set("q", query);
        url.searchParams.set("page", String(page));
        for (const slug of selectedCorpora) url.searchParams.append("corpus", slug);
        try {
          const response = await fetch(url, { headers: { accept: "application/json" } });
          if (!response.ok) return false;
          const payload = (await response.json()) as SearchPayload;
          const hits = payload.results;
          if (!Array.isArray(hits)) return false;

          if (!append) {
            listNode = null;
            shown = 0;
          }
          if (hits.length === 0 && shown === 0) {
            results.replaceChildren(stateNode("冇符合嘅結果", "試下換個寫法，簡體字都會歸一到繁體。"));
            return true;
          }
          if (listNode === null) {
            listNode = document.createElement("ul");
            listNode.className = "hits";
          }
          for (const hit of hits) {
            const item = hitNode(hit);
            if (item !== null) listNode.append(item);
          }
          shown += hits.length;
          total = typeof payload.total === "number" ? payload.total : shown;
          currentPage = typeof payload.page === "number" ? payload.page : page;
          results.replaceChildren(listNode);
          renderFooter();
          return true;
        } catch {
          return false;
        }
      };

      if (query !== "") {
        results.replaceChildren(stateNode("檢索中…", "正在查全庫。"));
        void load(1, false).then((served) => {
          if (!served) results.replaceChildren(unavailable());
        });
      }
    }
  </script>
</Base>
