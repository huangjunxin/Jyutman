---
const siteName = "粵語文叢";
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="歷史粵語文獻的 OCR 閱讀站，規劃建設中。" />
    <title>{siteName} Jyutman</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f4ede1;
        --surface: #fbf7ef;
        --rule: #d9cbb6;
        --text: #2a211c;
        --muted: #6e6257;
        --primary: #6e4b33;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #15120e;
          --surface: #1e1a15;
          --rule: #3a3128;
          --text: #e8dfd2;
          --muted: #a69786;
          --primary: #c79a6e;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background: var(--bg);
        color: var(--text);
        font-family: "Noto Serif HK", "Source Han Serif", "Songti TC", serif;
        text-align: center;
      }
      main {
        padding: 3rem 4rem;
        border: 1px solid var(--rule);
        border-radius: 4px;
        background: var(--surface);
      }
      h1 {
        margin: 0 0 1rem;
        font-size: clamp(2rem, 6vw, 3rem);
        font-weight: 500;
        letter-spacing: 0.15em;
        text-indent: 0.15em;
        color: var(--primary);
      }
      p {
        margin: 0;
        color: var(--muted);
        letter-spacing: 0.35em;
        text-indent: 0.35em;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{siteName}</h1>
      <p>規劃建設中</p>
    </main>
  </body>
</html>
