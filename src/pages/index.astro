---
import JsonLd from "../components/JsonLd.astro";
import Progress from "../components/Progress.astro";
import SearchBar from "../components/SearchBar.astro";
import Yuwai from "../components/Yuwai.astro";
import Base from "../layouts/Base.astro";
import { getCorpora, getIssues, getPages, getSiteTotals } from "../utils/corpus.ts";
import { pageParam } from "../utils/reader.ts";

const corpora = getCorpora();
const totals = getSiteTotals();

const cards = corpora.map((corpus) => {
  const issues = getIssues(corpus.slug);
  const first = issues[0];
  const firstPage = first ? getPages(corpus.slug, first.issue)[0] : undefined;
  return {
    corpus,
    issueLabel: corpus.issueCount > 1 ? `${corpus.issueCount} 期` : "單冊",
    href:
      first && firstPage
        ? `/read/${corpus.slug}/${first.issue}/${pageParam(firstPage.page)}/`
        : `/browse/${corpus.slug}/`,
  };
});

const siteUrl = (Astro.site ?? new URL("https://jyutman.com")).href;
---

<Base
  title="粵語文叢 · 讀返十九世紀嘅粵語"
  description="1842 至 1907 年粵語白話文獻的閱讀平台：方言報紙、傳教士讀本與識字課本，逐葉展示底本來源與校對狀態。"
  current={undefined}
>
  <Fragment slot="head">
    <JsonLd
      data={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "粵語文叢",
        alternateName: "Jyutman",
        url: siteUrl,
        inLanguage: "zh-Hant",
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${siteUrl}search/?q={query}`,
          },
          "query-input": "required name=query",
        },
      }}
    />
  </Fragment>

  <div class="wrap">
    <section class="hero">
      <h1>讀返十九世紀嘅粵語</h1>
      <p class="lede">
        1842 至 1907 年嘅粵語白話文獻：傳教士讀本、方言報紙、識字課本，而家可以檢索、閱讀、引用。
      </p>

      <SearchBar />
    </section>

    <Yuwai />

    <section>
      <div class="sec-head">
        <h2>語料</h2>
        <p>
          已發佈 {totals.corpusCount} 個語料 · {totals.pageCount} 葉 · {totals.articleCount} 篇　<a
            href="/browse/">全部書目 →</a
          >
        </p>
      </div>

      <div class="grid">
        {
          cards.map(({ corpus, issueLabel, href }) => (
            <article class="card">
              <div class="card-body">
                <h3><a href={href}>{corpus.title}</a></h3>
                <p class="sub">
                  {corpus.year ?? "年代待考"} · {issueLabel} · {corpus.pageCount} 葉
                </p>
                <Progress
                  verified={corpus.verifiedPages}
                  total={corpus.pageCount}
                  label={`葉級校對進度 · 已核驗 ${corpus.verifiedPages} / ${corpus.pageCount}`}
                />
                <p class="meta">
                  <span class="badge pub">已發佈</span>
                  <span>{corpus.articleCount} 篇</span>
                  <a href={href}>閱讀 →</a>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <Yuwai />

    <section>
      <div class="sec-head">
        <h2>點樣讀</h2>
        <p>三個動作：閱讀、豎排、檢索</p>
      </div>
      <div class="feats">
        <div class="feat">
          <span class="no">其一</span>
          <h3>文本閱讀＋來源信息</h3>
          <p>分段 OCR 文本配豎排閱讀，逐葉展示底本、藏館、葉碼同校對狀態。</p>
        </div>
        <div class="feat">
          <span class="no">其二</span>
          <h3>豎排閱讀</h3>
          <p>
            跟底本方向排印，右起豎排、標點用豎排字形；亦可即時切換橫排。正文一律用襯線，豎排時行氣唔會斷。
          </p>
        </div>
        <div class="feat">
          <span class="no">其三</span>
          <h3>繁簡異體歸一檢索</h3>
          <p>
            輸入簡體或異體字，都查得到底本嘅繁體原文。歸一只發生喺檢索層，展示層永遠保留原字，唔改寫、唔現代化。
          </p>
          <span class="feat-state">已開放。</span>
        </div>
      </div>
    </section>
  </div>

  <Yuwai size="sm" />
</Base>
