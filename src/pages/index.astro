---
import JsonLd from "../components/JsonLd.astro";
import SearchBar from "../components/SearchBar.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Base from "../layouts/Base.astro";
import {
  getCorpora,
  getCorpus,
  getCorpusTranslatedCount,
  getFirstReadablePage,
  getIssue,
  getIssues,
  getJyutping,
  getPage,
  getPages,
  getSiteTotals,
  getTranslations,
} from "../utils/corpus.ts";
import { corpusMeta, formatWan, issueLabel } from "../utils/corpus-meta.ts";
import { leadExcerpt } from "../utils/excerpt.ts";
import { normalize } from "../utils/normalize.ts";
import { pageParam, percent, readingsByIndex, renderAnnotatedParagraph, type ArticleBlock } from "../utils/reader.ts";
import { locateAndSlice } from "../utils/search-planner.ts";

const totals = getSiteTotals();
const siteUrl = (Astro.site ?? new URL("https://jyutman.com")).href;

const readHref = (slug: string, issue: string, page: number) => `/read/${slug}/${issue}/${pageParam(page)}/`;
const searchHref = (q: string) => `/search/?q=${encodeURIComponent(q)}`;

// ---- 樣張同示意圖：廣東白話報第一期（第 006、009 葉；檢索示例喺同期搵首個命中） ----
const GD = "gd-vernacular-paper";
const GD_ISSUE = "issue-01";
const gd = getCorpus(GD);
const gdIssue = getIssue(GD, GD_ISSUE);
if (!gd || !gdIssue) throw new Error(`首頁樣張：搵唔到 ${GD}/${GD_ISSUE}`);
const gdTitle = corpusMeta(gd).shortTitle;
const gdLabel = issueLabel(gd.issueCount, GD_ISSUE);
const gdDate = gdIssue.issue_date ?? "日期待考";

/** 某葉第一篇文章連篇首摘錄（截到 minChars 字之後嘅句末標點）。 */
function sample(page: number, minChars: number) {
  const doc = getPage(GD, GD_ISSUE, page);
  const article = doc?.blocks.find((block): block is ArticleBlock => block.type === "article");
  const lead = article && leadExcerpt(article.text, minChars);
  if (!doc || !article || !lead) throw new Error(`首頁樣張：${GD}/${GD_ISSUE} 第 ${page} 葉冇正文`);
  return { page, status: doc.status, article, lead, href: readHref(GD, GD_ISSUE, page) };
}

const specimen = sample(6, 30);
const specimenHtml = renderAnnotatedParagraph(
  specimen.lead.text,
  specimen.lead.start,
  readingsByIndex(getJyutping(GD, GD_ISSUE)[specimen.article.id]),
);
const specimenTranslated = getTranslations(GD, GD_ISSUE)[specimen.article.id] !== undefined;
const vertical = sample(9, 24);

const DEMO_QUERY = "广东";
const demoTarget = normalize(DEMO_QUERY);
const kwic = getPages(GD, GD_ISSUE)
  .flatMap((doc) =>
    doc.blocks.flatMap((block) =>
      block.type === "article" ? [{ page: doc.page, snippet: locateAndSlice(block.text, demoTarget, 8) }] : [],
    ),
  )
  .find((hit) => hit.snippet.highlight !== null);

// ---- 語料卡：首個多期語料做主打卡，其餘疊喺右邊 ----
const cards = getCorpora().map((corpus, index) => {
  const issues = getIssues(corpus.slug).map((issue) => ({
    ...issue,
    label: issueLabel(corpus.issueCount, issue.issue),
    href: readHref(corpus.slug, issue.issue, getFirstReadablePage(corpus.slug, issue.issue)),
    pct: percent(issue.verified_pages, issue.pages),
  }));
  return {
    corpus,
    meta: corpusMeta(corpus, index),
    issues,
    href: issues[0]?.href ?? `/browse/${corpus.slug}/`,
    pct: percent(corpus.verifiedPages, corpus.pageCount),
    translated: getCorpusTranslatedCount(corpus.slug),
  };
});
const featureIndex = Math.max(
  0,
  cards.findIndex((card) => card.corpus.issueCount > 1),
);
const feature = cards[featureIndex];
const others = cards.filter((_, index) => index !== featureIndex);

const stats = [
  { value: String(totals.corpusCount), unit: "個語料", label: "Corpora · 已發佈" },
  { value: String(totals.pageCount), unit: "葉", label: "Scanned pages · 掃描葉" },
  { value: String(totals.articleCount), unit: "篇", label: "Articles · 篇章" },
  { value: formatWan(totals.characterCount), unit: "萬字", label: "Characters · 正文字數" },
];
---

<Base
  title="粵語文叢 · 讀返十九世紀嘅粵語"
  description="1842 至 1907 年粵語白話文獻的閱讀平台：方言報紙、傳教士讀本與識字課本，逐葉展示底本來源與校對狀態。"
  current={undefined}
  headerSearch={false}
>
  <Fragment slot="head">
    <JsonLd
      data={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "粵語文叢",
        alternateName: "Jyutman",
        url: siteUrl,
        inLanguage: "zh-Hant",
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${siteUrl}search/?q={query}`,
          },
          "query-input": "required name=query",
        },
      }}
    />
  </Fragment>

  <section class="hero watermark-host">
    <span class="watermark" aria-hidden="true">叢</span>
    <div class="hero__inner wrap">
      <div class="hero__main">
        <p class="eyebrow eyebrow--rule">1842 — 1907 · 粵語白話文獻</p>
        <h1 class="hero__title">
          <span>讀返</span>
          <span class="hero__accent">十九世紀</span>
          <span>嘅粵語</span>
        </h1>
        <p class="hero__lede">
          1842 至 1907 年嘅粵語白話文獻：傳教士讀本、方言報紙、識字課本，而家可以檢索、閱讀、引用。
        </p>
        <div class="hero__search">
          <SearchBar variant="hero" inputId="home-q" />
        </div>
        <p class="hero__try">
          <span>試試：</span>
          <a class="chip" href={searchHref("廣東")}>廣東</a>
          <a class="chip" href={searchHref("唔係")}>唔係</a>
          <a class="chip" href={searchHref(DEMO_QUERY)}>{DEMO_QUERY}<span class="hero__simp">簡</span></a>
        </p>
      </div>

      <div class="specimen-wrap">
        <figure class="specimen" data-specimen data-layout="vertical" aria-labelledby="specimen-title">
          <div class="specimen__head">
            <div class="specimen__id">
              <div class="specimen__source" id="specimen-title">{gdTitle} · {gdLabel}</div>
              <div class="specimen__meta">{gdDate} · 第 {pageParam(specimen.page)} 葉</div>
            </div>
            <div class="specimen__controls">
              <div class="seg seg--sm" role="group" aria-label="排版方向">
                <button type="button" data-layout-set="vertical" aria-pressed="true">豎排</button>
                <button type="button" data-layout-set="horizontal" aria-pressed="false">橫排</button>
              </div>
              <button type="button" class="toggle toggle--sm" data-jp-toggle aria-pressed="true">粵拼</button>
            </div>
          </div>
          <div class="specimen__body">
            <div class="specimen__text">
              <p class="specimen__title">{specimen.article.title}</p>
              <p class="specimen__para" set:html={specimenHtml} />
            </div>
          </div>
          <div class="specimen__foot">
            <span class="specimen__badges">
              <StatusBadge status={specimen.status} />
              {specimenTranslated && <span class="badge badge--kapok">附今譯</span>}
            </span>
            <a class="specimen__more" href={specimen.href}>讀全文 →</a>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="全站數字">
    <div class="stats__grid wrap">
      {
        stats.map((stat) => (
          <div class="stat">
            <div class="stat__figure">
              <span class="stat__value">{stat.value}</span>
              <span class="stat__unit">{stat.unit}</span>
            </div>
            <div class="stat__label">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="corpora" aria-labelledby="corpora-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Corpora · 語料</p>
          <h2 class="sec-head__title" id="corpora-title">語料</h2>
          <p class="sec-head__sub">
            已發佈 {totals.corpusCount} 個語料 · {totals.pageCount} 葉 · {totals.articleCount} 篇；全站已核驗 {
              totals.verifiedPages
            } 葉（{percent(totals.verifiedPages, totals.pageCount)}%）
          </p>
        </div>
        <a class="sec-head__link" href="/browse/">全部書目 →</a>
      </div>

      <div class="corpora__grid">
        {
          feature && (
            <article class:list={["feature", "tone-block", `tone-${feature.meta.tone}`]}>
              <span class="corner" aria-hidden="true" />
              <div class="feature__top">
                <div class="feature__year">{feature.corpus.year ?? "年代待考"}</div>
                <div class="feature__kind">
                  {feature.meta.era && (
                    <>
                      {feature.meta.era}
                      <br />
                    </>
                  )}
                  {feature.meta.kind}
                </div>
              </div>
              <div>
                <h3 class="feature__title" lang={feature.meta.script === "en" ? "en" : undefined}>
                  {feature.corpus.title}
                </h3>
                <p class="feature__facts">
                  {feature.corpus.pageCount} 葉 · {feature.corpus.articleCount} 篇
                  {feature.translated > 0 && ` · ${feature.translated} 篇附今譯`}
                </p>
              </div>
              <ul class="feature__issues">
                {feature.issues.map((issue) => (
                  <li>
                    <a class="issue-row" href={issue.href}>
                      <span class="issue-row__label">{issue.label}</span>
                      <span class="issue-row__facts">
                        {issue.issue_date ?? "日期待考"} · {issue.pages} 葉 · {issue.articles} 篇
                      </span>
                      <span class="issue-row__progress">
                        <span class="meter meter--on-dark issue-row__meter" style={`--pct:${issue.pct}%`} aria-hidden="true">
                          <i />
                        </span>
                        <span class="visually-hidden">已核驗</span>
                        {issue.verified_pages} / {issue.pages}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="feature__foot">
                <div class="feature__progress">
                  <span>
                    葉級校對進度 · 已核驗 {feature.corpus.verifiedPages} / {feature.corpus.pageCount} 葉
                  </span>
                  <span class="feature__pct">{feature.pct}%</span>
                </div>
                <div class="meter meter--on-dark feature__meter" style={`--pct:${feature.pct}%`} aria-hidden="true">
                  <i />
                </div>
                <div class="feature__actions">
                  <a class="btn feature__read" href={feature.href}>
                    進入閱讀 →
                  </a>
                  <a class="btn feature__browse" href={`/browse/${feature.corpus.slug}/`}>
                    逐葉校對狀態
                  </a>
                </div>
              </div>
            </article>
          )
        }

        {
          others.length > 0 && (
            <div class="corpora__side">
              {others.map((card) => (
                <article class:list={["side-card", "tone-block", `tone-${card.meta.tone}`, "lift"]}>
                  <span class="corner" aria-hidden="true" />
                  <div class="side-card__top">
                    <span class="side-card__year">{card.corpus.year ?? "年代待考"}</span>
                    <span class="side-card__kind">
                      {card.corpus.issueCount > 1 ? `${card.corpus.issueCount} 期` : "單冊"} · {card.corpus.pageCount} 葉 ·{" "}
                      {card.corpus.articleCount} 篇
                    </span>
                  </div>
                  <h3 class="side-card__title" lang={card.meta.script === "en" ? "en" : undefined}>
                    {card.corpus.title}
                  </h3>
                  <div class="side-card__foot">
                    <div class="side-card__progress">
                      <span>
                        已核驗 {card.corpus.verifiedPages} / {card.corpus.pageCount} 葉
                      </span>
                      <span class="side-card__pct">{card.pct}%</span>
                    </div>
                    <div class="meter side-card__meter" style={`--pct:${card.pct}%`} aria-hidden="true">
                      <i />
                    </div>
                    <a class="side-card__cta" href={card.href}>
                      開始閱讀 →<span class="visually-hidden">：{card.corpus.title}</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap">
      <p class="eyebrow">How to read · 點樣讀</p>
      <h2 class="howto__title" id="howto-title">三個動作：閱讀、豎排、檢索</h2>
      <div class="howto__grid">
        <div class="howto__col">
          <a
            class="tile tile--source"
            href={specimen.href}
            aria-label={`打開${gdTitle}${gdLabel}第 ${pageParam(specimen.page)} 葉`}
          >
            <span class="mini-card">
              <span class="mini-card__head">
                <span class="mini-card__title">本葉來源</span>
                <StatusBadge status={specimen.status} />
              </span>
              <span class="mini-card__rows">
                <span class="mini-card__key">語料</span><span>{gd.title}</span>
                <span class="mini-card__key">期號</span><span>{gdLabel}（{gdDate}）</span>
                <span class="mini-card__key">葉序號</span><span class="mono">{pageParam(specimen.page)}</span>
                <span class="mini-card__key">底本</span><span>{gd.sourceLine}</span>
                <span class="mini-card__key">授權</span><span>CC BY-SA 4.0</span>
              </span>
            </span>
          </a>
          <div class="ordinal">其一</div>
          <h3 class="howto__h3">文本閱讀＋來源信息</h3>
          <p class="howto__text">分段 OCR 文本配豎排閱讀，逐葉展示底本、藏館、葉碼同校對狀態。</p>
        </div>

        <div class="howto__col">
          <a
            class="tile tile--vertical"
            href={vertical.href}
            aria-label={`打開〈${vertical.article.title}〉（${gdLabel}第 ${pageParam(vertical.page)} 葉）`}
          >
            <span class="tile__vertical">
              <span class="tile__vtitle">{vertical.article.title}</span>
              <span>{vertical.lead.text}</span>
            </span>
          </a>
          <div class="ordinal">其二</div>
          <h3 class="howto__h3">豎排閱讀</h3>
          <p class="howto__text">
            跟底本方向排印，右起豎排、標點用豎排字形；亦可即時切換橫排。正文一律用襯線，豎排時行氣唔會斷。
          </p>
        </div>

        <div class="howto__col">
          <a class="tile tile--search" href={searchHref(DEMO_QUERY)} aria-label={`檢索「${DEMO_QUERY}」`}>
            <span class="fold">
              <span class="fold__from">{DEMO_QUERY}</span>
              <span class="eyebrow eyebrow--sm">歸一 →</span>
              <span class="fold__to">{demoTarget}</span>
            </span>
            {
              kwic && (
                <span class="kwic">
                  <span class="kwic__line">
                    {kwic.snippet.pre}
                    <mark>{kwic.snippet.highlight}</mark>
                    {kwic.snippet.post}
                  </span>
                  <span class="kwic__src">
                    {gdTitle} · {gdLabel} · 第 {pageParam(kwic.page)} 葉
                  </span>
                </span>
              )
            }
          </a>
          <div class="ordinal">其三</div>
          <h3 class="howto__h3">繁簡歸一檢索</h3>
          <p class="howto__text">
            輸入簡體字，都查得到底本嘅繁體原文。歸一只發生喺檢索層，展示層永遠保留原字，唔改寫、唔現代化。
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // 首頁樣張：豎排／橫排、粵拼開關（狀態只靠 aria-pressed 同 figure 上嘅 data／class）。
  for (const figure of document.querySelectorAll<HTMLElement>("[data-specimen]")) {
    const layoutButtons = [...figure.querySelectorAll<HTMLButtonElement>("[data-layout-set]")];
    for (const button of layoutButtons) {
      button.addEventListener("click", () => {
        figure.dataset.layout = button.dataset.layoutSet;
        for (const other of layoutButtons) other.setAttribute("aria-pressed", String(other === button));
      });
    }
    const jp = figure.querySelector<HTMLButtonElement>("[data-jp-toggle]");
    jp?.addEventListener("click", () => {
      const on = jp.getAttribute("aria-pressed") !== "true";
      jp.setAttribute("aria-pressed", String(on));
      figure.classList.toggle("no-jp", !on);
    });
  }
</script>

<style>
  /* ---- 1a Hero ---- */
  .hero {
    --wm-top: -7vw;
    --wm-right: -4vw;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(48px, 6vw, 88px);
    padding-top: clamp(48px, 7vw, 104px);
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  .hero__main {
    flex: 1 1 520px;
    min-width: 0;
  }

  .hero__main .eyebrow {
    margin: 0;
  }

  .hero__title {
    margin-top: 28px;
    font-size: clamp(64px, 9.2vw, 136px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero__title span {
    display: block;
  }

  .hero__title .hero__accent {
    color: var(--kapok);
  }

  .hero__lede {
    margin: 32px 0 0;
    max-width: 30em;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.75;
    color: var(--graphite);
    text-wrap: pretty;
  }

  .hero__search {
    margin-top: 40px;
  }

  .hero__try {
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--graphite);
  }

  .hero__simp {
    font-size: 11px;
    color: var(--muted-gold);
  }

  /* 原文樣張：後面一塊錯位木棉紅，前面白色 figure */
  .specimen-wrap {
    position: relative;
    flex: 1 1 400px;
    min-width: 0;
    max-width: 520px;
    margin: 0 auto;
    padding: 0 0 22px 22px;
  }

  .specimen-wrap::before {
    content: "";
    position: absolute;
    top: 22px;
    right: 22px;
    bottom: 0;
    left: 0;
    background: var(--kapok);
  }

  .specimen {
    position: relative;
    margin: 0;
    background: var(--card);
    border: 1px solid var(--line-12);
  }

  .specimen__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line-08);
  }

  .specimen__id {
    line-height: 1.35;
  }

  .specimen__source {
    font-family: var(--font-serif);
    font-size: 16px;
  }

  .specimen__meta {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--graphite);
  }

  .specimen__controls {
    display: flex;
    gap: 6px;
  }

  .specimen__body {
    display: flex;
    justify-content: flex-end;
    height: 400px;
    padding: 26px 28px;
    overflow: hidden;
  }

  .specimen__text {
    writing-mode: vertical-rl;
    max-width: 100%;
    max-height: 100%;
    font-family: var(--font-serif);
    font-size: 27px;
    line-height: 2.3;
    letter-spacing: 0.06em;
  }

  .specimen[data-layout="horizontal"] .specimen__text {
    writing-mode: horizontal-tb;
    width: 100%;
  }

  .specimen__title {
    margin: 0;
    margin-block-end: 16px;
    font-size: 32px;
    line-height: 1.6;
    letter-spacing: 0.12em;
    color: var(--kapok);
  }

  .specimen__para {
    margin: 0;
  }

  .specimen__para :global(rt) {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--kapok);
  }

  .specimen.no-jp .specimen__para :global(rt) {
    display: none;
  }

  .specimen__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 18px;
    border-top: 1px solid var(--line-08);
    font-size: 13px;
  }

  .specimen__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .specimen__badges :global(.badge) {
    font-size: 13px;
  }

  .specimen__more {
    font-size: 14px;
    font-weight: 600;
  }

  /* ---- 1b 數字帶 ---- */
  .stats {
    background: var(--ink);
    color: var(--parchment);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px 40px;
    padding-top: 44px;
    padding-bottom: 44px;
  }

  .stat {
    padding-left: 20px;
    border-left: 1px solid var(--on-dark-20);
  }

  .stat__figure {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .stat__value {
    font-family: var(--font-serif);
    font-size: clamp(44px, 4.6vw, 64px);
    line-height: 1;
  }

  .stat__unit {
    font-size: 17px;
    color: var(--kapok-on-dark);
  }

  .stat__label {
    margin-top: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-66);
  }

  /* ---- 1c 語料 ---- */
  .corpora {
    padding: clamp(64px, 8vw, 112px) 0;
  }

  .sec-head {
    display: flex;
