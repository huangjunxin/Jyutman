---
import Eyebrow from "../../components/Eyebrow.astro";
import Glass from "../../components/Glass.astro";
import LeafGrid from "../../components/LeafGrid.astro";
import Base from "../../layouts/Base.astro";
import {
  getCorpora,
  getFirstReadablePage,
  getIssues,
  getPages,
  getSiteTotals,
} from "../../utils/corpus.ts";
import { corpusMeta, issueLabel } from "../../utils/corpus-meta.ts";
import { pageParam, percent } from "../../utils/reader.ts";

const totals = getSiteTotals();

const sections = getCorpora().map((corpus, index) => {
  const issues = getIssues(corpus.slug).map((issue) => ({
    issue,
    // 原型書目庫：單冊語料標「全冊」
    label: corpus.issueCount > 1 ? issueLabel(corpus.issueCount, issue.issue) : "全冊",
    pages: getPages(corpus.slug, issue.issue),
  }));
  const first = issues[0];
  return {
    corpus,
    meta: corpusMeta(corpus, index),
    issues,
    pct: percent(corpus.verifiedPages, corpus.pageCount),
    readHref: first?.pages.length
      ? `/read/${corpus.slug}/${first.issue.issue}/${pageParam(getFirstReadablePage(corpus.slug, first.issue.issue))}/`
      : undefined,
  };
});
---

<Base
  title="書目庫 · 粵語文叢"
  description={`已發佈 ${totals.corpusCount} 個粵語語料，共 ${totals.pageCount} 葉 / ${totals.articleCount} 篇；逐葉列出底本年代、葉數與校對進度。`}
  current="browse"
>
  <section class="head">
    <div class="wrap head__top">
      <div class="head__text">
        <Eyebrow text="Catalogue · 書目庫" />
        <h1>書目庫</h1>
        <p class="lede">1842 至 1907 年粵語白話文獻 · 底本屬公有領域 · 掃描影像來自 Internet Archive</p>
      </div>
      <div class="totals">
        <div class="total"><span class="total__num">{totals.corpusCount}</span><span class="total__unit">個語料</span></div>
        <div class="total"><span class="total__num">{totals.pageCount}</span><span class="total__unit">葉</span></div>
        <div class="total"><span class="total__num">{totals.articleCount}</span><span class="total__unit">篇</span></div>
        <div class="total total--ok">
          <span class="total__num">{totals.verifiedPages}</span><span class="total__unit">葉已核驗</span>
        </div>
      </div>
    </div>
    <div class="wrap legend">
      <span><i class="swatch swatch--ok" aria-hidden="true"></i>已核驗（上游 status 為 verified）</span>
      <span><i class="swatch swatch--todo" aria-hidden="true"></i>待校葉</span>
      <span>每一格係一葉 · 撳落去直接跳去嗰葉</span>
    </div>
  </section>

  {
    sections.map(({ corpus, meta, issues, pct, readHref }) => (
      <section class="corpus" aria-labelledby={`c-${corpus.slug}`}>
        <div class="wrap corpus__inner">
          <Glass tone={meta.tone} class="cover" paneClass="cover__pane">
            <div>
              <div class="cover__kind">{meta.kind}</div>
              <div class:list={["cover__year", { "cover__year--none": corpus.year == null }]}>{corpus.year ?? "年代待考"}</div>
            </div>
            <div class:list={["cover__title", { "cover__title--en": meta.script === "en" }]} aria-hidden="true">
              {meta.spineTitle}
            </div>
            <div class="cover__slug">{corpus.slug}</div>
          </Glass>

          <div class="info">
            <h2 id={`c-${corpus.slug}`} class:list={{ en: meta.script === "en" }}>
              <a href={`/browse/${corpus.slug}/`}>{corpus.title}</a>
            </h2>

            <div class="facts">
              <div class="fact"><span class="fact__num">{corpus.pageCount}</span><span class="fact__unit">葉（掃描）</span></div>
              <div class="fact"><span class="fact__num">{corpus.articleCount}</span><span class="fact__unit">篇</span></div>
              <div class="fact">
                <span class="fact__num">{corpus.issueCount}</span>
                <span class="fact__unit">{corpus.issueCount > 1 ? "期" : "冊"}</span>
              </div>
              <div class="fact fact--ok">
                <span class="fact__num">{corpus.verifiedPages}</span><span class="fact__unit">葉已核驗</span>
              </div>
            </div>

            <div>
              <div class="progress__head">
                <span class="progress__label">
                  葉級校對進度 · 已核驗 {corpus.verifiedPages} / {corpus.pageCount} 葉（另 {corpus.needsReviewPages} 葉待校）
                </span>
                <span class="progress__pct">{pct}%</span>
              </div>
              <div class="meter" style={`--pct:${pct}%`} aria-hidden="true"><i /></div>
            </div>

            <div>
              {issues.map(({ issue, label, pages }) => (
                <div class="issue" role="group" aria-labelledby={`i-${corpus.slug}-${issue.issue}`}>
                  <div class="issue__meta" id={`i-${corpus.slug}-${issue.issue}`}>
                    <div class="issue__label">{label}</div>
                    <div class="issue__date">{issue.issue_date ?? "日期待考"}</div>
                    <div class="issue__stat">
                      已核驗 {issue.verified_pages} / {issue.pages}
                    </div>
                  </div>
                  <LeafGrid corpus={corpus.slug} issue={issue.issue} pages={pages} />
                </div>
              ))}
            </div>

            <div class="foot">
              <span class="foot__src">已發佈 · 底本來源：{corpus.sourceLine}</span>
              <div class="foot__actions">
                <a class="btn btn--outline" href={`/browse/${corpus.slug}/`}>期號目錄</a>
                {readHref && <a class="btn btn--solid" href={readHref}>進入閱讀 →</a>}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <p class="wrap note">只列上游已發佈嘅語料；其餘底本仍喺資料管道整理，未進入發佈層，故此處唔顯示。</p>
</Base>


<style>
  .head,
  .corpus {
    border-bottom: 1px solid var(--line-10);
  }

  .head__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-top: clamp(48px, 6vw, 88px);
    padding-bottom: 28px;
  }

  .head__text {
    flex: 1 1 460px;
    min-width: 0;
  }

  h1 {
    margin: 14px 0 18px;
    font-size: clamp(44px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 0;
    max-width: 34em;
    font-size: 19px;
    color: var(--graphite);
    text-wrap: pretty;
  }

  .totals {
    display: flex;
    flex-wrap: wrap;
  }

  .total {
    padding: 0 24px;
    border-left: 1px solid var(--line-12);
  }

  .total__num,
  .fact__num {
    display: block;
    font-family: var(--latin);
    font-weight: 300;
  }

  .total__num {
    font-size: 36px;
    line-height: 1;
  }

  .total__unit,
  .fact__unit {
    display: block;
    font-size: 15px;
    color: var(--graphite);
  }

  .total--ok .total__num,
  .fact--ok .fact__num {
    color: var(--green);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    padding-bottom: 24px;
    font-size: 15px;
    color: var(--graphite);
  }

  .legend > span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .swatch {
    flex: none;
    width: 13px;
    height: 13px;
  }

  .swatch--ok {
    background: var(--green);
  }

  .swatch--todo {
    border: 1px solid rgba(176, 118, 16, 0.6);
  }

  .corpus__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    padding-block: 48px;
  }

  /* 封面：大號燈籠框（自己木框） */
  .cover {
    flex: 0 1 240px;
    min-width: 200px;
    min-height: 340px;
  }

  .cover__pane {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 22px;
  }

  .cover__kind {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .cover__year {
    margin-top: 10px;
    font-family: var(--latin);
    font-size: 52px;
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--tone-num);
  }

  /* 年代待考：細字木色（琥珀 --tone-num 只可以用喺 40px 以上） */
  .cover__year--none {
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    color: var(--wood);
  }

  .cover__title {
    align-self: flex-end;
    writing-mode: vertical-rl;
    font-size: 30px;
    line-height: 1;
    letter-spacing: 0.18em;
  }

  .cover__title--en {
    font-size: 24px;
    letter-spacing: 0.06em;
  }

  .cover__slug {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--graphite);
  }

  /* 資料欄 */
  .info {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h2 {
    font-size: clamp(28px, 2.8vw, 36px);
    line-height: 1.1;
  }

  h2.en {
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.15;
  }

  h2 a {
    color: var(--wood);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    border-block: 1px solid var(--line-12);
  }

  .fact {
    padding: 14px 16px;
    border-left: 1px solid var(--line-08);
  }

  .fact:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .fact__num {
    font-size: 34px;
    line-height: 1.1;
  }

  .progress__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .progress__label {
    font-size: 16px;
  }

  .progress__pct {
    font-family: var(--latin);
    font-size: 32px;
    line-height: 1;
    color: var(--green);
  }

  .meter {
    --h: 10px;
    --meter-track: var(--line-14);
    --meter-fill: var(--green);
    margin-top: 10px;
  }

  /* 每期一列：期名／日期／核驗數 + 逐葉格；上邊虛線 */
  .issue {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px dashed var(--line-14);
  }

  .issue__meta {
    line-height: 1.4;
  }

  .issue__label {
    font-size: 19px;
  }

  .issue__date,
  .issue__stat {
    font-size: 14px;
  }

  .issue__date {
    color: var(--graphite);
  }

  /* 14px 細字：#0b7a31 喺頁面底只有 4.2:1，用 --green-text 先夠 4.5:1 */
  .issue__stat {
    font-weight: 600;
    color: var(--green-text);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .foot__src {
    font-size: 15px;
    color: var(--graphite);
  }

  .foot__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .note {
    margin-block: 0;
    padding-block: 28px 72px;
    font-size: 15px;
    color: var(--graphite);
  }
</style>
