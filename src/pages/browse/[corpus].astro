---
import type { GetStaticPaths } from "astro";

import JsonLd from "../../components/JsonLd.astro";
import LeafGrid from "../../components/LeafGrid.astro";
import Base from "../../layouts/Base.astro";
import {
  getCorpora,
  getCorpus,
  getFirstReadablePage,
  getIssueToc,
  getIssues,
  getPages,
} from "../../utils/corpus.ts";
import { corpusMeta, issueLabel } from "../../utils/corpus-meta.ts";
import { pageParam, percent } from "../../utils/reader.ts";

export const getStaticPaths = (() => {
  return getCorpora().map((corpus) => ({
    params: { corpus: corpus.slug },
    props: { slug: corpus.slug },
  }));
}) satisfies GetStaticPaths;

/** 篇目預設顯示條數；多出嘅由「睇晒 N 條」展開（冇 JS 時全部顯示）。 */
const TOC_PREVIEW = 8;

const { slug } = Astro.props;
const corpus = getCorpus(slug);
if (!corpus) {
  throw new Error(`manifest 冇語料 ${slug}`);
}

const meta = corpusMeta(
  corpus,
  getCorpora().findIndex((c) => c.slug === slug),
);
const single = corpus.issueCount <= 1;

const issues = getIssues(slug).map((issue) => {
  const pages = getPages(slug, issue.issue);
  return {
    issue,
    pages,
    // 原型單冊語料期號標籤寫「全冊」
    label: single ? "全冊" : issueLabel(corpus.issueCount, issue.issue),
    href:
      pages.length > 0
        ? `/read/${slug}/${issue.issue}/${pageParam(getFirstReadablePage(slug, issue.issue))}/`
        : undefined,
    toc: getIssueToc(slug, issue.issue),
  };
});

const siteUrl = (Astro.site ?? new URL("https://jyutman.com")).href;
---

<Base
  title={`${corpus.title} · 書目庫 · 粵語文叢`}
  description={`${corpus.title}（${corpus.year ?? "年代待考"}）：${corpus.pageCount} 葉 / ${corpus.articleCount} 篇，逐期列出葉數與校對進度，可進入閱讀器。`}
  current="browse"
>
  <Fragment slot="head">
    <JsonLd
      data={{
        "@context": "https://schema.org",
        "@type": "Book",
        name: corpus.title,
        ...(corpus.year !== null ? { datePublished: String(corpus.year) } : {}),
        inLanguage: "zh-Hant",
        license: "https://creativecommons.org/licenses/by-sa/4.0/",
        url: `${siteUrl}browse/${corpus.slug}/`,
      }}
    />
  </Fragment>

  <section class:list={["band", `tone-${meta.tone}`]}>
    <div class="wrap band__inner">
      <nav class="crumbs" aria-label="麵包屑">
        <a href="/browse/">書目庫</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{corpus.title}</span>
      </nav>

      <div class="band__head">
        <div class="band__title">
          <div class="band__year">
            {corpus.year !== null && <span class="band__yearnum latin">{corpus.year}</span>}
            <span class="band__kind">{meta.kind}</span>
          </div>
          <h1>{corpus.title}</h1>
          <p class="band__source">底本來源：{corpus.sourceLine}</p>
        </div>
        <dl class="band__stats">
          <div><dt>葉（掃描）</dt><dd class="latin">{corpus.pageCount}</dd></div>
          <div><dt>篇</dt><dd class="latin">{corpus.articleCount}</dd></div>
          <div><dt>{single ? "冊" : "期"}</dt><dd class="latin">{corpus.issueCount}</dd></div>
          <div><dt>葉已核驗</dt><dd class="latin">{corpus.verifiedPages}</dd></div>
        </dl>
      </div>

      <div class="band__progress">
        <div class="progress-row">
          <span>
            葉級校對進度 · 已核驗 {corpus.verifiedPages} / {corpus.pageCount} 葉（另 {corpus.needsReviewPages} 葉待校）
          </span>
          <span class="band__pct latin">{percent(corpus.verifiedPages, corpus.pageCount)}%</span>
        </div>
        <div
          class="meter meter--on-tone band__meter"
          style={`--pct:${percent(corpus.verifiedPages, corpus.pageCount)}%`}
          aria-hidden="true"
        >
          <i></i>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap issues" aria-labelledby="issues-title">
    <div class="issues__head">
      <h2 id="issues-title">期號目錄</h2>
      <div class="legend">
        <span><i class="legend__ok" aria-hidden="true"></i>已核驗</span>
        <span><i class="legend__todo" aria-hidden="true"></i>待校</span>
        <span>每一格係一葉 · 撳落去直接閱讀</span>
      </div>
    </div>

    {
      issues.map(({ issue, pages, label, href, toc }) => (
        <section class="issue" id={issue.issue} aria-labelledby={`${issue.issue}-label`}>
          <div class="issue__meta">
            <h3 class="issue__label" id={`${issue.issue}-label`}>
              {label}
            </h3>
            <div class="issue__code mono">{issue.issue}</div>
            {issue.issue_date ? (
              <div class="issue__date">{issue.issue_date}</div>
            ) : (
              <span class="badge badge--amber issue__nodate">日期待考</span>
            )}
            <div class="issue__count">
              {issue.pages} 葉 · {issue.articles} 篇
            </div>
            {issue.date_note && (
              <details class="date-note">
                <summary>
                  <span class="date-note__show">日期考證 <span aria-hidden="true">▾</span></span>
                  <span class="date-note__hide">收埋日期考證</span>
                </summary>
                <div class="date-note__body">{issue.date_note}</div>
              </details>
            )}
            {href ? (
              <a class="btn btn--solid issue__go" href={href}>
                第一葉 <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="badge badge--amber">未開放</span>
            )}
          </div>

          <div class="issue__body">
            <div>
              <div class="progress-row">
                <span>
                  已核驗 {issue.verified_pages} / {issue.pages} 葉
                </span>
                <span class="issue__pct latin">{percent(issue.verified_pages, issue.pages)}%</span>
              </div>
              <div
                class="meter issue__meter"
                style={`--pct:${percent(issue.verified_pages, issue.pages)}%`}
                aria-hidden="true"
              >
                <i></i>
              </div>
            </div>

            <LeafGrid corpus={slug} issue={issue.issue} pages={pages} />

            {toc.length > 0 && (
              <div>
                <p class="label toc__label" id={`${issue.issue}-toc-label`}>
                  篇目 · {toc.length} 條
                </p>
                <ol class="toc" id={`${issue.issue}-toc`} aria-labelledby={`${issue.issue}-toc-label`}>
                  {toc.map((entry) => (
                    <li>
                      <a href={`/read/${slug}/${issue.issue}/${pageParam(entry.page)}/#${entry.id}`}>
                        <span class="toc__page">{pageParam(entry.page)}</span>
                        <span>{entry.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
                {toc.length > TOC_PREVIEW && (
                  <button
                    type="button"
                    class="btn btn--outline btn--sm toc__toggle"
                    aria-controls={`${issue.issue}-toc`}
                    aria-expanded="true"
                    data-toc-toggle
                    data-total={toc.length}
                    data-preview={TOC_PREVIEW}
                    hidden
                  >
                    收埋
                  </button>
                )}
              </div>
            )}
          </div>
        </section>
      ))
    }

    <p class="foot-note">
      頁數、篇數、校對進度均取自上游發佈層 <code>issues.jsonl</code>；葉碼用掃描序號，永遠連續。
    </p>
    <a class="back" href="/browse/"><span aria-hidden="true">←</span> 返書目庫</a>
  </section>
</Base>

<script>
  // 篇目摺疊：冇 JS 時全部顯示；有 JS 先收埋 TOC_PREVIEW 條之後嘅，並顯示「睇晒 N 條」掣。
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-toc-toggle]")) {
    const list = document.getElementById(btn.getAttribute("aria-controls") ?? "");
    if (!list) continue;
    const preview = Number(btn.dataset.preview);
    const set = (open: boolean) => {
      list.querySelectorAll<HTMLLIElement>(":scope > li").forEach((li, i) => {
        li.hidden = !open && i >= preview;
      });
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "收埋" : `睇晒 ${btn.dataset.total} 條`;
    };
    set(false);
    btn.hidden = false;
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  }
</script>

<style>
  /* ---- 語料色帶頁頭：底 --tone、字 --tone-on（琥珀用木色，其餘 #f8f7f2） ---- */
  .band {
    background: var(--tone);
    color: var(--tone-on);
  }

  .band__inner {
    padding-top: 28px;
    padding-bottom: clamp(28px, 2.8vw, 36px);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 16px;
    color: var(--tone-on-dim);
  }

  .crumbs a {
    color: var(--tone-on);
  }

  /* 全站焦點環係寶藍，喺寶藍色帶上睇唔到 */
  .crumbs a:focus-visible {
    outline-color: var(--tone-on);
  }

  .band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .band__title {
    flex: 1 1 520px;
    min-width: 0;
  }

  .band__year {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 24px;
  }

  .band__yearnum {
    font-size: clamp(48px, 5vw, 64px);
    font-weight: 300;
    line-height: 0.82;
    letter-spacing: -0.04em;
  }

  .band__kind {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tone-on-dim);
  }

  .band h1 {
    margin-top: 22px;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .band__source {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--tone-on-dim);
  }

  .band__stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .band__stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 0 22px;
    border-left: 1px solid var(--tone-on-line);
  }

  .band__stats dd {
    margin: 0;
    font-size: 36px;
    font-weight: 300;
    line-height: 1;
  }

  .band__stats dt {
    font-size: 15px;
    color: var(--tone-on-dim);
  }

  .band__progress {
    margin-top: 32px;
  }

  .progress-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 16px;
  }

  .band__pct {
    font-size: 30px;
    line-height: 1;
  }

  .band__meter {
    margin-top: 10px;
  }

  /* ---- 期號目錄 ---- */
  .issues {
    padding-top: 40px;
    padding-bottom: 96px;
  }

  .issues__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 14px;
  }

  .issues__head h2 {
    font-size: clamp(26px, 2.6vw, 32px);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    font-size: 15px;
    color: var(--graphite);
  }

  .legend > span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend i {
    width: 13px;
    height: 13px;
  }

  .legend__ok {
    background: var(--green);
  }

  .legend__todo {
    border: 1px solid rgba(176, 118, 16, 0.6);
  }

  .issue {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    padding: 28px 0;
    border-top: 2px solid var(--wood);
    scroll-margin-top: var(--header-h);
  }

  .issue__meta {
    display: flex;
    flex: 0 1 260px;
    flex-direction: column;
    gap: 10px;
    min-width: 220px;
  }

  .issue__label {
    font-size: 34px;
    font-weight: 400;
    line-height: 1;
  }

  .issue__code {
    font-size: 15px;
    color: var(--graphite);
  }

  .issue__date {
    font-size: 18px;
    font-weight: 600;
  }

  /* 日期待考／未開放：原型 2px 10px、15px/700 */
  .issue__meta .badge {
    align-self: flex-start;
    padding: 2px 10px;
    font-size: 15px;
  }

  .issue__count {
    font-size: 16px;
    color: var(--graphite);
  }

  .date-note summary {
    display: block;
    width: fit-content;
    color: var(--amber-text);
    font-size: 15px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    list-style: none;
  }

  .date-note summary::-webkit-details-marker {
    display: none;
  }

  .date-note__hide,
  .date-note[open] .date-note__show {
    display: none;
  }

  .date-note[open] .date-note__hide {
    display: inline;
  }

  .date-note__body {
    margin-top: 10px;
    padding: 12px 14px;
    border-left: 4px solid var(--amber-text);
    background: rgba(176, 118, 16, 0.08);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  /* 原型「第一葉 →」中間係一個空格（約 .25em），唔係 .btn 嘅 8px gap */
  .issue__go {
    align-self: flex-start;
    gap: 0.25em;
    margin-top: 6px;
    padding: 10px 18px;
    border: 0;
    font-size: 16px;
  }

  .issue__body {
    display: flex;
    flex: 1 1 560px;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .issue__pct {
    font-size: 30px;
    line-height: 1;
    color: var(--green);
  }

  .issue__meter {
    --meter-track: var(--line-14);
    --meter-fill: var(--green);
    margin-top: 8px;
  }

  .toc__label {
    margin: 0 0 4px;
  }

  .toc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 8px;
    height: 100%;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-08);
    font-size: 16px;
    line-height: 1.45;
    color: var(--wood);
    transition: color 200ms;
  }

  .toc a:hover {
    color: var(--blue);
    text-decoration: none;
  }

  .toc__page {
    padding-top: 1px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--graphite);
  }

  /* 原型 6px 14px；hover 只轉淡寶藍底，邊唔變 */
  .toc__toggle {
    margin-top: 12px;
    padding: 6px 14px;
  }

  .toc__toggle:hover {
    border-color: var(--blue-a30);
    background: var(--blue-a08);
  }

  /* .btn 嘅 display 蓋過 UA [hidden]；冇 JS 時呢粒掣要真係唔見 */
  .toc__toggle[hidden] {
    display: none;
  }

  .foot-note {
    margin: 24px 0 0;
    font-size: 15px;
    color: var(--graphite);
  }

  .foot-note code {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .back {
    display: inline-block;
    margin-top: 20px;
    font-weight: 600;
  }
</style>
