---
/**
 * Lucide 風格 inline SVG 圖示（24 viewBox、currentColor 描邊、圓頭）；純裝飾，aria-hidden。
 * 路徑抄自設計原型（design handoff）；circle-dashed 為原型嘅虛線圓圈（stroke-dasharray 3 3）。
 */
export type IconName =
  | "search"
  | "arrow-right"
  | "arrow-up-right"
  | "check"
  | "github"
  | "lock"
  | "circle-dashed"
  | "x"
  | "chevron-down";

interface Props {
  name: IconName;
  /** 邊長 px，預設 18。 */
  size?: number;
  /** 描邊粗幼，預設 2（「已開放」剔號用 2.2）。 */
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 2, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  "arrow-right": '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  "arrow-up-right": '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  "circle-dashed": '<circle cx="12" cy="12" r="9" stroke-dasharray="3 3"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  "chevron-down": '<path d="m6 9 6 6 6-6"/>',
};
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
></svg>
