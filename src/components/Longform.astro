---
/**
 * 長文頁內容版面（關於、數據開放共用）：左欄「本頁」錨點導航（≥1080px 黏頂，寶藍中文序號）+ 內容欄（最闊 820px）。
 * 各段由頁面寫成 <section id class="lf-section">，段頭用 .ordinal.ordinal--lg + h2.lf-h2，內文用 p.lf-text；
 * 錨點平滑捲動靠 global.css 嘅 scroll-behavior（減少動態時自動關閉）。
 */
import { chineseNumeral } from "../utils/corpus-meta.ts";

interface Props {
  /** 段落錨點同導航文字，順序即編號「一、二、三…」。 */
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<div class="longform wrap">
  <nav class="longform__nav" aria-labelledby="longform-nav-label">
    <p class="longform__label label" id="longform-nav-label">本頁</p>
    {
      sections.map((section, index) => (
        <a href={`#${section.id}`}>
          <span class="longform__num" aria-hidden="true">
            {chineseNumeral(index + 1)}
          </span>
          {section.label}
        </a>
      ))
    }
  </nav>
  <div class="longform__body">
    <slot />
  </div>
</div>

<style>
  .longform {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px clamp(40px, 6vw, 96px);
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 8vw, 120px);
  }

  .longform__nav {
    flex: 0 1 200px;
    min-width: 180px;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1080px) {
    .longform__nav {
      position: sticky;
      top: calc(var(--header-h) + 26px);
    }
  }

  .longform__label {
    margin: 0 0 10px;
  }

  .longform__nav a {
    display: flex;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--line-10);
    font-size: 17px;
    line-height: 1.75;
    color: var(--wood);
    transition: color 200ms;
  }

  .longform__nav a:hover {
    color: var(--blue);
    text-decoration: none;
  }

  .longform__num {
    width: 20px;
    flex: none;
    color: var(--blue);
  }

  .longform__body {
    flex: 1 1 560px;
    min-width: 0;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 88px);
  }

  /* 段落：錨點預留頁首高度 */
  .longform__body :global(.lf-section) {
    scroll-margin-top: calc(var(--header-h) + 22px);
  }

  .longform__body :global(.lf-h2) {
    margin: 16px 0 20px;
    font-size: clamp(28px, 2.8vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .longform__body :global(.lf-text) {
    margin: 0 0 18px;
    font-size: 18px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  /* 長路徑（jsonl 路徑、檔名）喺窄螢幕可以斷行，唔好撐闊頁面 */
  .longform__body :global(.lf-text code) {
    overflow-wrap: anywhere;
  }
</style>
