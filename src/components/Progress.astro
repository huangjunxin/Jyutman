---
import { percent } from "../utils/reader.ts";

interface Props {
  verified: number;
  total: number;
  label: string;
}

const { verified, total, label } = Astro.props;
const ratio = percent(verified, total);
---

<div class="prog">
  <div class="prog-head">
    <span>{label}</span>
    <span class="pct">{ratio}%</span>
  </div>
  <div class="track">
    <i style={`width:${ratio}%`}></i>
  </div>
</div>
