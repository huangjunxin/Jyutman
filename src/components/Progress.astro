---
/** 舊版進度條（過渡期保留畀未改版頁面編譯）；新頁面直接用 .meter。 */
import { percent } from "../utils/reader.ts";

interface Props {
  verified: number;
  total: number;
  label: string;
}

const { verified, total, label } = Astro.props;
const ratio = percent(verified, total);
---

<div>
  <div>
    <span>{label}</span>
    <span>{ratio}%</span>
  </div>
  <div class="meter" style={`--pct:${ratio}%`} aria-hidden="true"><i></i></div>
</div>
