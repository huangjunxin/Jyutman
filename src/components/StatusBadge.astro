---
/**
 * 頁級狀態徽章：上游 status 經 statusBadge() 映射成 ok（已核驗，翠綠淡底實心點）／ocr（OCR 未校，琥珀淡底空心點）／done。
 * label 可覆寫文案（例如閱讀頁「OCR 未校 · 歡迎報錯」）；size sm 14px（預設）、md 16px 用於閱讀頁卡頭；
 * variant outline 令 OCR 未校改用線框版（首頁樣張），已核驗照舊。
 */
import { statusBadge } from "../utils/reader.ts";

interface Props {
  status: string;
  label?: string;
  size?: "sm" | "md";
  variant?: "outline";
  class?: string;
}

const { status, label, size = "sm", variant, class: className, ...rest } = Astro.props;
const badge = statusBadge(status);
const tone = variant === "outline" && badge.tone === "ocr" ? "ocr-outline" : badge.tone;
---

<span class:list={["badge", `badge--${tone}`, size === "md" && "badge--md", className]} {...rest}>{label ?? badge.label}</span>
