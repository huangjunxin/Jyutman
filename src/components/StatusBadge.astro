---
/**
 * 葉級狀態徽章：上游 status 經 statusBadge() 映射成 ok（已核驗，實心點）／ocr（OCR 未校，空心點）／done。
 * label 可覆寫文案（例如閱讀頁「OCR 未校 · 歡迎報錯」）；size md 用於閱讀頁卡頭。
 */
import { statusBadge } from "../utils/reader.ts";

interface Props {
  status: string;
  label?: string;
  size?: "sm" | "md";
  class?: string;
}

const { status, label, size = "sm", class: className } = Astro.props;
const badge = statusBadge(status);
---

<span class:list={["badge", `badge--${badge.tone}`, size === "md" && "badge--md", className]}>{label ?? badge.label}</span>
