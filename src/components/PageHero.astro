---
/**
 * 長文頁頁頭（關於、數據開放共用）：大字水印、眉標、H1、導語；
 * H1 內容經 slot="title" 傳入（可夾木棉紅 span），預設 slot 放導語下面嘅流程條／授權卡。
 */
interface Props {
  eyebrow: string;
  /** 水印字（真文字，aria-hidden）。 */
  mark: string;
  lead: string;
}

const { eyebrow, mark, lead } = Astro.props;
---

<section class="page-hero watermark-host">
  <div class="watermark" aria-hidden="true">{mark}</div>
  <div class="page-hero__inner wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title"><slot name="title" /></h1>
    <p class="page-hero__lead">{lead}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    border-bottom: 1px solid var(--line-10);
  }

  .watermark {
    --wm-size: min(48vw, 640px);
    --wm-right: -3vw;
    --wm-top: -6vw;
  }

  .page-hero__inner {
    position: relative;
    padding-top: clamp(56px, 7vw, 104px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .eyebrow {
    margin: 0;
  }

  .page-hero__title {
    margin-top: 14px;
    font-size: clamp(56px, 8vw, 112px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .page-hero__lead {
    margin: 28px 0 0;
    max-width: 34em;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.75;
    color: var(--graphite);
    text-wrap: pretty;
  }
</style>
